---
import type { Course } from "@multiserwis/shared";
import IndustrialIcon from "./IndustrialIcon.astro";

interface Props {
  course: Course;
  href: string;
}

const { course, href } = Astro.props;
const imageSrc = course.image.startsWith("/") ? course.image : `/${course.image}`;
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-brand-accent/40">
  <div class="relative aspect-16/10 overflow-hidden bg-slate-900">
    <img
      src={imageSrc}
      alt={course.title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      decoding="async"
      width="600"
      height="375"
    />
    <div class="absolute inset-0 bg-linear-to-t from-slate-950/60 via-transparent to-transparent"></div>
    <div class="absolute left-3 top-3 rounded-md bg-brand-accent px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-sm">
      {course.category}
    </div>
    {course.hasOnline && (
      <div class="absolute right-3 top-3 rounded-md bg-brand-primary/95 backdrop-blur-xs px-2.5 py-1 text-xs font-semibold text-white inline-flex items-center gap-1.5">
        <IndustrialIcon name="play" class="w-3.5 h-3.5 text-brand-accent" />
        <span>Teoria online 24/7</span>
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="space-y-2.5 mb-5">
      <h3 class="text-xl font-heading font-bold text-slate-900 leading-snug group-hover:text-brand-primary transition-colors">
        {course.title}
      </h3>
      <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
        {course.description}
      </p>
    </div>

    <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-1.5 text-xs text-slate-600 font-semibold">
        <IndustrialIcon name="clock" class="w-4 h-4 text-brand-accent" />
        <span>{course.duration}</span>
      </div>
      <div class="text-lg font-extrabold text-brand-primary font-heading">
        {course.price} <span class="text-xs font-semibold text-slate-500">zw. z VAT</span>
      </div>
    </div>

    <div class="mt-4 flex gap-2.5">
      <a
        href={href}
        class="flex-1 text-center py-2.5 bg-brand-primary text-white font-bold text-xs uppercase tracking-wider rounded-md hover:bg-brand-dark transition-colors"
      >
        Szczegóły
      </a>
      <a
        href={`/szkolenia?zapisz=${course.id}`}
        class="px-4 py-2.5 bg-brand-accent/10 text-brand-accent font-bold text-xs uppercase tracking-wider rounded-md hover:bg-brand-accent hover:text-white transition-colors inline-flex items-center justify-center gap-1.5"
        title="Zapisz się na szkolenie"
      >
        <span>Zapisz się</span>
        <IndustrialIcon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</article>
