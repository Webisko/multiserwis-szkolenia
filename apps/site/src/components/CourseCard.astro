---
import type { Course } from "@multiserwis/shared";

interface Props {
  course: Course;
  href: string;
}

const { course, href } = Astro.props;
const imageSrc = course.image.startsWith("/") ? course.image : `/${course.image}`;
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-slate-200/80 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-brand-accent/30">
  <div class="relative aspect-16/10 overflow-hidden bg-slate-900">
    <img
      src={imageSrc}
      alt={course.title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-linear-to-t from-slate-950/60 via-transparent to-transparent"></div>
    <div class="absolute left-3 top-3 rounded-sm bg-brand-accent px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow-sm">
      {course.category}
    </div>
    {course.hasOnline && (
      <div class="absolute right-3 top-3 rounded-sm bg-brand-primary/90 backdrop-blur-xs px-2.5 py-1 text-[11px] font-semibold text-white">
        Teoria Online 24/7
      </div>
    )}
  </div>
  
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="space-y-2 mb-4">
      <h3 class="text-lg font-heading font-bold text-slate-900 leading-snug group-hover:text-brand-primary transition-colors">
        {course.title}
      </h3>
      <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
        {course.description}
      </p>
    </div>

    <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-1.5 text-xs text-slate-500 font-medium">
        <span>⏱️</span> {course.duration}
      </div>
      <div class="text-base font-bold text-brand-primary font-heading">
        {course.price}
      </div>
    </div>

    <div class="mt-4 flex gap-2">
      <a
        href={href}
        class="flex-1 text-center py-2.5 bg-brand-primary text-white font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-brand-dark transition-colors"
      >
        Szczegóły
      </a>
      <a
        href={`/szkolenia?zapisz=${course.id}`}
        class="px-3.5 py-2.5 bg-brand-accent/10 text-brand-accent font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-brand-accent hover:text-white transition-colors flex items-center justify-center"
        title="Zapisz się"
      >
        Zapisz →
      </a>
    </div>
  </div>
</article>
