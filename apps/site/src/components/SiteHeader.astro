---
// SiteHeader.astro - Główny nagłówek portalu MultiSerwis Szkolenia
---

<header class="w-full bg-brand-dark text-white sticky top-0 z-50 shadow-md">
  <!-- Top Bar -->
  <div class="bg-slate-950/80 border-b border-white/10 text-xs py-2 px-4 md:px-8 hidden sm:block">
    <div class="max-w-7xl mx-auto flex justify-between items-center text-slate-300">
      <div class="flex items-center gap-6">
        <a href="tel:+48730101000" class="flex items-center gap-2 hover:text-brand-accent transition-colors">
          <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>+48 730 101 000 / 570 403 806</span>
          <span class="text-slate-400 font-normal">(Pn-Pt 8:00 - 16:00)</span>
        </a>
        <span class="text-slate-600">|</span>
        <span class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>ul. Siemieradzkiego 18, 99-300 Kutno</span>
        </span>
      </div>
      <div class="flex items-center gap-4 text-[11px] uppercase tracking-wider text-slate-200 font-semibold">
        <span>Akredytacja UDT &amp; ŚBŁ-WIT</span>
        <span class="text-slate-600">•</span>
        <span>Certyfikat ISO 9001</span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="max-w-7xl mx-auto px-4 md:px-8 py-3.5 flex justify-between items-center">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group cursor-pointer" title="MultiSerwis Strona Główna">
      <div class="w-10 h-10 bg-brand-accent rounded-sm flex items-center justify-center transform group-hover:rotate-45 transition-transform duration-300 p-1.5 shadow-md shadow-orange-600/30">
        <img src="/logo.svg" alt="MultiSerwis Logo" class="w-full h-full transform group-hover:-rotate-45 transition-transform duration-300" />
      </div>
      <div class="flex flex-col">
        <span class="text-2xl font-heading font-extrabold text-white leading-none tracking-tight">
          MULTI<span class="text-brand-accent">SERWIS</span>
        </span>
        <span class="text-[10px] text-slate-100 font-bold tracking-[0.2em] uppercase leading-none mt-1">
          Profesjonalne Szkolenia
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden lg:flex items-center gap-6 text-sm font-medium">
      <!-- Szkolenia Dropdown (bez emotikonek) -->
      <div class="relative group">
        <a href="/szkolenia" class="flex items-center gap-1 text-slate-200 hover:text-brand-accent transition-colors py-2">
          Szkolenia
          <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <div class="absolute left-0 top-full hidden group-hover:block w-64 bg-slate-900 border border-slate-700/80 rounded-lg shadow-2xl py-2 mt-1 z-50">
          <a href="/szkolenia" class="block px-4 py-2 text-xs font-bold uppercase tracking-wider text-brand-accent hover:bg-slate-800">
            Wszystkie Szkolenia →
          </a>
          <div class="border-t border-slate-800 my-1"></div>
          <a href="/szkolenia/udt" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            Szkolenia UDT (Wózki, Podesty)
          </a>
          <a href="/szkolenia/imbigs" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            Maszyny IMBiGS (Koparki, Ładowarki)
          </a>
          <a href="/szkolenia/sep" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            Uprawnienia SEP (G1, G2, G3)
          </a>
          <a href="/szkolenia/spawalnictwo" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            Spawalnictwo (MIG/MAG, TIG)
          </a>
          <a href="/szkolenia/pozostale" class="block px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            Specjalistyczne i BHP
          </a>
        </div>
      </div>

      <a href="/wynajem" class="text-slate-200 hover:text-brand-accent transition-colors py-2">Wynajem</a>
      <a href="/uslugi" class="text-slate-200 hover:text-brand-accent transition-colors py-2">Usługi</a>
      <a href="/harmonogram" class="text-slate-200 hover:text-brand-accent transition-colors py-2">Harmonogram</a>
      <a href="/o-nas" class="text-slate-200 hover:text-brand-accent transition-colors py-2">O nas</a>
      <a href="/kontakt" class="text-slate-200 hover:text-brand-accent transition-colors py-2">Kontakt</a>
    </div>

    <!-- Actions / Rozwijane Menu Paneli (Bez emotikonek) -->
    <div class="hidden sm:flex items-center gap-3">
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-sm bg-brand-accent px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-orange-500/20 hover:bg-brand-accentHover transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Panele Systemu</span>
          <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Menu Paneli -->
        <div class="absolute right-0 top-full hidden group-hover:block w-72 bg-slate-900 border border-slate-700/80 rounded-lg shadow-2xl py-2 mt-1 z-50">
          <div class="px-4 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-800">
            Wybierz Panel Dedykowany
          </div>
          <a
            href="/panel/kursant"
            class="flex items-center gap-3 px-4 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white transition-colors group/item"
          >
            <div class="w-8 h-8 rounded-sm bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white group-hover/item:text-brand-accent transition-colors">Panel Kursanta (LMS)</div>
              <div class="text-xs text-slate-400">E-learning, testy i egzaminy UDT</div>
            </div>
          </a>
          <a
            href="/panel/administrator"
            class="flex items-center gap-3 px-4 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white transition-colors group/item border-t border-slate-800/60"
          >
            <div class="w-8 h-8 rounded-sm bg-brand-accent/10 text-brand-accent flex items-center justify-center font-bold">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white group-hover/item:text-brand-accent transition-colors">Panel Administratora</div>
              <div class="text-xs text-slate-400">Zarządzanie kursami, finanse, baza</div>
            </div>
          </a>
          <a
            href="/panel/menedzer"
            class="flex items-center gap-3 px-4 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white transition-colors group/item border-t border-slate-800/60"
          >
            <div class="w-8 h-8 rounded-sm bg-blue-500/10 text-blue-400 flex items-center justify-center font-bold">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white group-hover/item:text-brand-accent transition-colors">Panel Menedżera</div>
              <div class="text-xs text-slate-400">Koordynacja terminów, instruktorzy</div>
            </div>
          </a>
          <a
            href="/panel/opiekun"
            class="flex items-center gap-3 px-4 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white transition-colors group/item border-t border-slate-800/60"
          >
            <div class="w-8 h-8 rounded-sm bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div>
              <div class="font-bold text-white group-hover/item:text-brand-accent transition-colors">Strefa Opiekuna Firmy</div>
              <div class="text-xs text-slate-400">Panel B2B, pracownicy, rozliczenia</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile Burger Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="lg:hidden p-2 text-slate-300 hover:text-white focus:outline-none"
      aria-label="Otwórz menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Drawer Menu (bez Start i bez emotikonek) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-900 border-t border-slate-800 px-6 py-4 space-y-3">
    <a href="/szkolenia" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Katalog Szkoleń</a>
    <div class="pl-4 space-y-2 border-l border-slate-800 text-sm">
      <a href="/szkolenia/udt" class="block text-slate-400 hover:text-white">Szkolenia UDT</a>
      <a href="/szkolenia/imbigs" class="block text-slate-400 hover:text-white">Maszyny IMBiGS</a>
      <a href="/szkolenia/sep" class="block text-slate-400 hover:text-white">Uprawnienia SEP</a>
      <a href="/szkolenia/spawalnictwo" class="block text-slate-400 hover:text-white">Spawalnictwo</a>
      <a href="/szkolenia/pozostale" class="block text-slate-400 hover:text-white">BHP i Inne</a>
    </div>
    <a href="/wynajem" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Wynajem Maszyn</a>
    <a href="/uslugi" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Usługi</a>
    <a href="/harmonogram" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Harmonogram</a>
    <a href="/o-nas" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">O nas</a>
    <a href="/kontakt" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Kontakt</a>
    
    <div class="pt-4 border-t border-slate-800 space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Dostęp do Paneli:</div>
      <div class="grid grid-cols-2 gap-2">
        <a
          href="/panel/kursant"
          class="text-center py-2.5 px-2 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-sm border border-slate-700"
        >
          Kursant (LMS)
        </a>
        <a
          href="/panel/administrator"
          class="text-center py-2.5 px-2 bg-brand-accent hover:bg-brand-accentHover text-white font-bold text-xs rounded-sm shadow-sm"
        >
          Administrator
        </a>
        <a
          href="/panel/menedzer"
          class="text-center py-2.5 px-2 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-sm border border-slate-700"
        >
          Menedżer
        </a>
        <a
          href="/panel/opiekun"
          class="text-center py-2.5 px-2 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-sm border border-slate-700"
        >
          Opiekun B2B
        </a>
      </div>
      <a href="tel:+48730101000" class="block text-center py-2 text-xs text-slate-400">
        Infolinia: +48 730 101 000
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", (!isHidden).toString());
    });
  }
</script>
