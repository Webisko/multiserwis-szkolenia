---
import IndustrialIcon from "./IndustrialIcon.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="w-full bg-brand-dark text-white sticky top-0 z-50 shadow-md">
  <!-- Top Bar -->
  <div class="bg-slate-950/90 border-b border-white/10 text-xs py-2 px-4 md:px-8 hidden sm:block">
    <div class="max-w-7xl mx-auto flex justify-between items-center text-slate-300">
      <div class="flex items-center gap-6">
        <a href="tel:+48730101000" class="flex items-center gap-2 hover:text-brand-accent transition-colors font-medium">
          <IndustrialIcon name="phone" class="w-3.5 h-3.5 text-brand-accent" />
          <span>+48 730 101 000 / 570 403 806</span>
          <span class="text-slate-400 font-normal">(Pn–Pt 8:00–16:00)</span>
        </a>
        <span class="text-slate-700">|</span>
        <span class="flex items-center gap-2">
          <IndustrialIcon name="pin" class="w-3.5 h-3.5 text-brand-accent" />
          <span>ul. Henryka Siemiradzkiego 18, 99-300 Kutno</span>
        </span>
      </div>
      <div class="flex items-center gap-4 text-[11px] uppercase tracking-wider text-slate-200 font-semibold">
        <span>Akredytacja UDT i ŚBŁ-WIT</span>
        <span class="text-slate-600">•</span>
        <span>Certyfikat ISO 9001</span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <nav class="max-w-7xl mx-auto px-4 md:px-8 py-3.5 flex justify-between items-center" aria-label="Nawigacja główna">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group cursor-pointer" title="MultiSerwis – strona główna">
      <div class="w-10 h-10 bg-brand-accent rounded-md flex items-center justify-center transform group-hover:rotate-45 transition-transform duration-300 p-1.5 shadow-md shadow-orange-600/30">
        <img src="/logo.svg" alt="MultiSerwis Logo" class="w-full h-full transform group-hover:-rotate-45 transition-transform duration-300" />
      </div>
      <div class="flex flex-col">
        <span class="text-2xl font-heading font-extrabold text-white leading-none tracking-tight">
          MULTI<span class="text-brand-accent">SERWIS</span>
        </span>
        <span class="text-[10px] text-slate-200 font-bold tracking-[0.2em] uppercase leading-none mt-1">
          Profesjonalne szkolenia
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden lg:flex items-center gap-6 text-sm font-medium">
      <!-- Szkolenia Dropdown -->
      <div class="relative group">
        <a
          href="/szkolenia"
          aria-current={isActive("/szkolenia") ? "page" : undefined}
          class={`flex items-center gap-1.5 py-2 transition-colors ${isActive("/szkolenia") ? "text-brand-accent font-bold" : "text-slate-200 hover:text-brand-accent"}`}
        >
          <span>Szkolenia</span>
          <IndustrialIcon name="chevron-down" class="w-4 h-4 transition-transform group-hover:rotate-180" />
        </a>

        <!-- Dropdown Menu -->
        <div class="absolute left-0 top-full hidden group-hover:block w-72 bg-slate-900 border border-slate-700/80 rounded-xl shadow-2xl py-2.5 mt-0.5 z-50">
          <a href="/szkolenia" class="flex items-center justify-between px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-brand-accent hover:bg-slate-800 transition-colors">
            <span>Wszystkie szkolenia (katalog)</span>
            <IndustrialIcon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
          <div class="border-t border-slate-800 my-1.5"></div>
          <a href="/szkolenia/udt" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            <IndustrialIcon name="forklift" class="w-4 h-4 text-brand-accent shrink-0" />
            <span>Szkolenia UDT (wózki, podesty)</span>
          </a>
          <a href="/szkolenia/imbigs" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            <IndustrialIcon name="excavator" class="w-4 h-4 text-brand-accent shrink-0" />
            <span>Maszyny IMBiGS (koparki, ładowarki)</span>
          </a>
          <a href="/szkolenia/sep" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            <IndustrialIcon name="sep" class="w-4 h-4 text-brand-accent shrink-0" />
            <span>Uprawnienia SEP (G1, G2, G3)</span>
          </a>
          <a href="/szkolenia/spawalnictwo" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            <IndustrialIcon name="welding" class="w-4 h-4 text-brand-accent shrink-0" />
            <span>Spawalnictwo (MIG/MAG, TIG, MMA)</span>
          </a>
          <a href="/szkolenia/pozostale" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            <IndustrialIcon name="bhp" class="w-4 h-4 text-brand-accent shrink-0" />
            <span>Specjalistyczne i BHP</span>
          </a>
        </div>
      </div>

      <a
        href="/wynajem"
        aria-current={isActive("/wynajem") ? "page" : undefined}
        class={`py-2 transition-colors ${isActive("/wynajem") ? "text-brand-accent font-bold" : "text-slate-200 hover:text-brand-accent"}`}
      >
        Wynajem
      </a>
      <a
        href="/uslugi"
        aria-current={isActive("/uslugi") ? "page" : undefined}
        class={`py-2 transition-colors ${isActive("/uslugi") ? "text-brand-accent font-bold" : "text-slate-200 hover:text-brand-accent"}`}
      >
        Usługi
      </a>
      <a
        href="/harmonogram"
        aria-current={isActive("/harmonogram") ? "page" : undefined}
        class={`py-2 transition-colors ${isActive("/harmonogram") ? "text-brand-accent font-bold" : "text-slate-200 hover:text-brand-accent"}`}
      >
        Harmonogram
      </a>
      <a
        href="/o-nas"
        aria-current={isActive("/o-nas") ? "page" : undefined}
        class={`py-2 transition-colors ${isActive("/o-nas") ? "text-brand-accent font-bold" : "text-slate-200 hover:text-brand-accent"}`}
      >
        O nas
      </a>
      <a
        href="/kontakt"
        aria-current={isActive("/kontakt") ? "page" : undefined}
        class={`py-2 transition-colors ${isActive("/kontakt") ? "text-brand-accent font-bold" : "text-slate-200 hover:text-brand-accent"}`}
      >
        Kontakt
      </a>
    </div>

    <!-- Actions / Przycisk Szybkiego Logowania -->
    <div class="hidden sm:flex items-center gap-3">
      <button
        type="button"
        data-open-login-drawer
        class="inline-flex items-center gap-2 rounded-md bg-brand-accent px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-orange-500/20 hover:bg-brand-accentHover transition-all cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>Zaloguj się</span>
      </button>
    </div>

    <!-- Mobile Burger Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="lg:hidden p-2 text-slate-300 hover:text-white focus:outline-none"
      aria-label="Otwórz menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-900 border-t border-slate-800 px-6 py-4 space-y-3">
    <a href="/szkolenia" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Katalog szkoleń</a>
    <div class="pl-4 space-y-2 border-l border-slate-800 text-sm">
      <a href="/szkolenia/udt" class="block text-slate-400 hover:text-white">Szkolenia UDT</a>
      <a href="/szkolenia/imbigs" class="block text-slate-400 hover:text-white">Maszyny IMBiGS</a>
      <a href="/szkolenia/sep" class="block text-slate-400 hover:text-white">Uprawnienia SEP</a>
      <a href="/szkolenia/spawalnictwo" class="block text-slate-400 hover:text-white">Spawalnictwo</a>
      <a href="/szkolenia/pozostale" class="block text-slate-400 hover:text-white">BHP i specjalistyczne</a>
    </div>
    <a href="/wynajem" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Wynajem maszyn</a>
    <a href="/uslugi" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Usługi serwisowe</a>
    <a href="/harmonogram" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Harmonogram</a>
    <a href="/o-nas" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">O nas</a>
    <a href="/kontakt" class="block py-2 text-slate-200 font-medium hover:text-brand-accent">Kontakt</a>

    <div class="pt-4 border-t border-slate-800 space-y-2">
      <button
        type="button"
        data-open-login-drawer
        class="w-full text-center py-3 px-4 bg-brand-accent hover:bg-brand-accentHover text-white font-bold text-xs uppercase tracking-wider rounded-md shadow-sm cursor-pointer"
      >
        Zaloguj się
      </button>
      <a
        href="/rejestracja"
        class="block text-center py-2.5 px-4 border border-slate-700 hover:border-brand-accent text-slate-200 hover:text-white font-semibold text-xs uppercase tracking-wider rounded-md transition-colors"
      >
        Załóż konto (kursant / firma)
      </a>
      <a href="tel:+48730101000" class="block text-center py-2 text-xs text-slate-400">
        Infolinia: +48 730 101 000
      </a>
    </div>
  </div>
</header>

<!-- Wysuwany Panel Szybkiego Logowania (Slide-Over Drawer dla wszystkich ról) -->
<div
  id="ms-login-drawer-root"
  class="fixed inset-0 z-[100] hidden"
  aria-labelledby="ms-login-drawer-title"
  role="dialog"
  aria-modal="true"
>
  <!-- Backdrop -->
  <div
    id="ms-login-drawer-backdrop"
    class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs opacity-0 transition-opacity duration-300"
  ></div>

  <!-- Slide-over panel -->
  <div class="fixed inset-y-0 right-0 flex max-w-full pl-10">
    <div
      id="ms-login-drawer-panel"
      class="w-screen max-w-md transform translate-x-full transition-transform duration-300 ease-out bg-white text-slate-900 shadow-2xl flex flex-col justify-between border-l-4 border-brand-accent"
    >
      <!-- Top Header & Form -->
      <div class="p-6 sm:p-8 overflow-y-auto">
        <div class="flex items-start justify-between pb-6 border-b border-slate-200">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-brand-accent rounded-md flex items-center justify-center p-1.5 shadow-md shadow-orange-600/20">
              <img src="/logo.svg" alt="MultiSerwis" class="w-full h-full" />
            </div>
            <div>
              <h2 id="ms-login-drawer-title" class="text-xl font-heading font-extrabold text-slate-900 leading-tight">
                Zaloguj się
              </h2>
              <p class="text-xs text-slate-500 font-medium">
                Strefa kursanta, opiekuna firmy oraz panel zarządzania
              </p>
            </div>
          </div>
          <button
            type="button"
            id="ms-login-drawer-close"
            class="p-2 text-slate-400 hover:text-slate-700 rounded-md hover:bg-slate-100 transition-colors cursor-pointer"
            aria-label="Zamknij panel logowania"
          >
            <IndustrialIcon name="close" class="w-5 h-5" />
          </button>
        </div>

        <p class="text-sm text-slate-600 mt-5 mb-6 leading-relaxed">
          Wpisz swój adres e-mail i hasło. System automatycznie rozpozna Twój typ konta i przekieruje Cię do odpowiedniego panelu.
        </p>

        <div
          id="ms-login-drawer-error"
          class="hidden mb-5 p-3.5 rounded-md bg-red-50 border-l-4 border-red-500 text-xs font-semibold text-red-700"
        ></div>

        <form id="ms-login-drawer-form" method="post" class="space-y-5">
          <div>
            <label
              for="ms-drawer-email"
              class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
            >
              Adres e-mail
            </label>
            <input
              id="ms-drawer-email"
              name="email"
              type="email"
              autocomplete="username"
              required
              placeholder="np. imie.nazwisko@firma.pl"
              class="w-full px-4 py-3 border border-slate-300 rounded-md text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all"
            />
          </div>

          <div>
            <label
              for="ms-drawer-password"
              class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
            >
              Hasło
            </label>
            <input
              id="ms-drawer-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="••••••••••••"
              class="w-full px-4 py-3 border border-slate-300 rounded-md text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition-all"
            />
          </div>

          <button
            type="submit"
            id="ms-login-drawer-submit"
            class="w-full py-3.5 px-6 bg-brand-accent hover:bg-brand-accentHover text-white font-bold uppercase tracking-wider text-xs rounded-md shadow-lg shadow-orange-500/25 transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Zaloguj się do systemu</span>
            <IndustrialIcon name="arrow-right" class="w-4 h-4" />
          </button>
        </form>
      </div>

      <!-- Bottom Registration CTA (Kursant / Opiekun Firmy) -->
      <div class="p-6 sm:p-8 bg-slate-50 border-t border-slate-200">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">
          Nowy uczestnik lub firma?
        </div>
        <p class="text-sm font-semibold text-slate-800 mb-3">
          Nie masz jeszcze konta na platformie szkoleniowej?
        </p>
        <a
          href="/rejestracja"
          class="w-full py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider rounded-md transition-colors flex items-center justify-center gap-2"
        >
          <span>Załóż konto (kursant / opiekun firmy)</span>
          <IndustrialIcon name="arrow-right" class="w-4 h-4 text-brand-accent" />
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", (!isHidden).toString());
    });
  }

  // Slide-Over Login Drawer Logic
  const drawerRoot = document.getElementById("ms-login-drawer-root");
  const drawerBackdrop = document.getElementById("ms-login-drawer-backdrop");
  const drawerPanel = document.getElementById("ms-login-drawer-panel");
  const drawerClose = document.getElementById("ms-login-drawer-close");
  const drawerForm = document.getElementById("ms-login-drawer-form") as HTMLFormElement | null;
  const drawerError = document.getElementById("ms-login-drawer-error");
  const drawerSubmit = document.getElementById("ms-login-drawer-submit") as HTMLButtonElement | null;
  const emailInput = document.getElementById("ms-drawer-email") as HTMLInputElement | null;
  const passInput = document.getElementById("ms-drawer-password") as HTMLInputElement | null;

  function openLoginDrawer() {
    if (!drawerRoot || !drawerBackdrop || !drawerPanel) return;
    if (menu && !menu.classList.contains("hidden")) {
      menu.classList.add("hidden");
    }
    drawerRoot.classList.remove("hidden");
    requestAnimationFrame(() => {
      drawerBackdrop.classList.remove("opacity-0");
      drawerBackdrop.classList.add("opacity-100");
      drawerPanel.classList.remove("translate-x-full");
      drawerPanel.classList.add("translate-x-0");
      setTimeout(() => emailInput?.focus(), 150);
    });
  }

  function closeLoginDrawer() {
    if (!drawerRoot || !drawerBackdrop || !drawerPanel) return;
    drawerBackdrop.classList.remove("opacity-100");
    drawerBackdrop.classList.add("opacity-0");
    drawerPanel.classList.remove("translate-x-0");
    drawerPanel.classList.add("translate-x-full");
    setTimeout(() => {
      drawerRoot.classList.add("hidden");
    }, 300);
  }

  document.querySelectorAll("[data-open-login-drawer]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      openLoginDrawer();
    });
  });

  drawerClose?.addEventListener("click", closeLoginDrawer);
  drawerBackdrop?.addEventListener("click", closeLoginDrawer);
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawerRoot && !drawerRoot.classList.contains("hidden")) {
      closeLoginDrawer();
    }
  });

  // Auto-open if ?login=1 in URL
  if (new URLSearchParams(window.location.search).get("login") === "1") {
    openLoginDrawer();
  }

  drawerForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!emailInput || !passInput || !drawerSubmit) return;

    const email = emailInput.value.trim().toLowerCase();
    const password = passInput.value;

    if (drawerError) {
      drawerError.classList.add("hidden");
      drawerError.textContent = "";
    }

    const originalText = drawerSubmit.innerHTML;
    drawerSubmit.disabled = true;
    drawerSubmit.innerHTML = '<span>Logowanie...</span>';

    try {
      const res = await fetch("/api/auth/session", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.token) {
        throw new Error(data.message || "Nieprawidłowy adres e-mail lub hasło.");
      }

      localStorage.setItem("token", data.token);
      const role = data.user?.role || "STUDENT";
      const isProd = window.location.hostname.endsWith("multiserwis.edu.pl");
      const sso = `?sso_token=${encodeURIComponent(data.token)}`;

      if (role === "ADMIN") {
        window.location.href = isProd
          ? `https://panel.multiserwis.edu.pl/panel/administrator${sso}`
          : `/panel/administrator${sso}`;
      } else if (role === "MANAGER") {
        window.location.href = isProd
          ? `https://panel.multiserwis.edu.pl/panel/menedzer${sso}`
          : `/panel/menedzer${sso}`;
      } else if (role === "COMPANY_GUARDIAN") {
        window.location.href = isProd
          ? `https://szkolenia.multiserwis.edu.pl/panel/opiekun${sso}`
          : `/panel/opiekun${sso}`;
      } else {
        window.location.href = isProd
          ? `https://szkolenia.multiserwis.edu.pl/panel/kursant${sso}`
          : `/panel/kursant${sso}`;
      }
    } catch (err: any) {
      if (drawerError) {
        drawerError.textContent = err?.message || "Wystąpił błąd podczas logowania.";
        drawerError.classList.remove("hidden");
      }
      drawerSubmit.disabled = false;
      drawerSubmit.innerHTML = originalText;
    }
  });
</script>
