---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndustrialIcon from "../components/IndustrialIcon.astro";

const milestones = [
  {
    year: "2010",
    title: "Powstanie ośrodka szkoleniowego",
    desc: "Rozpoczęcie działalności szkoleniowej w Kutnie, skoncentrowanej w pierwszych latach na kursach operatorów wózków jezdniowych i spawalnictwie.",
  },
  {
    year: "2015",
    title: "Rozbudowa bazy manewrowej",
    desc: "Uruchomienie poligonu do robót ziemnych przy ul. Przemysłowej 2 oraz rozbudowa floty ładowarek teleskopowych Manitou i podnośników Genie.",
  },
  {
    year: "2020",
    title: "Rozbudowa parku maszynowego",
    desc: "Wprowadzenie nowych wózków czołowych, burt samowyładowczych i podnośników koszowych do intensywnych ćwiczeń manewrowych.",
  },
  {
    year: "2026",
    title: "Czołowy ośrodek regionu kutnowskiego",
    desc: "Ponad 5 000 przeszkolonych operatorów i stała obsługa zakładów przemysłowych w obrębie Łódzkiej Specjalnej Strefy Ekonomicznej (Podstrefa Kutno).",
  },
];
---

<BaseLayout
  title="O nas – MultiSerwis Kutno | Ośrodek szkolenia zawodowego i wynajem"
  description="Poznaj MultiSerwis w Kutnie (ul. Henryka Siemiradzkiego 18, poligon ul. Przemysłowa 2). Certyfikowany ośrodek szkoleń UDT, ŚBŁ-WIT (IMBiGS), SEP i spawania. Ponad 15 lat doświadczenia."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-dark text-white py-16 md:py-24 border-b border-slate-800 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/hero.webp"
        alt="Baza szkoleniowa MultiSerwis w Kutnie"
        width="1600"
        height="900"
        class="w-full h-full object-cover opacity-20 filter brightness-75 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/95 to-brand-primary/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block px-3.5 py-1 bg-brand-accent/20 border border-brand-accent/40 text-brand-accent text-xs font-bold uppercase tracking-wider rounded-md">
          Poznaj MultiSerwis
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black leading-tight">
          Ośrodek certyfikowanych szkoleń zawodowych w Kutnie
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Prowadzimy profesjonalne szkolenia stacjonarne, wykłady w klimatyzowanej sali przy ul. Siemiradzkiego 18 oraz intensywne zajęcia praktyczne na placu manewrowym przy ul. Przemysłowej 2 w Kutnie.
        </p>
      </div>
    </div>
  </section>

  <!-- Core Stats -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="p-4">
          <span class="text-3xl sm:text-4xl font-heading font-black text-brand-primary block">15+</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold mt-1 block">lat na rynku</span>
        </div>
        <div class="p-4">
          <span class="text-3xl sm:text-4xl font-heading font-black text-brand-accent block">5 000+</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold mt-1 block">wydanych uprawnień</span>
        </div>
        <div class="p-4">
          <span class="text-3xl sm:text-4xl font-heading font-black text-brand-primary block">98%</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold mt-1 block">zdawalności egzaminów</span>
        </div>
        <div class="p-4">
          <span class="text-3xl sm:text-4xl font-heading font-black text-emerald-600 block">100%</span>
          <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold mt-1 block">państwowe certyfikaty</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Story -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Kim jesteśmy</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 mt-1">
            Praktyczne umiejętności, które dają pewną pracę w przemyśle i budownictwie
          </h2>
        </div>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Ośrodek Szkolenia Kadr MultiSerwis działa w centrum Polski – w Kutnie, tuż przy skrzyżowaniu autostrad A1 i A2 oraz strefie przemysłowej. Od początku działalności stawiamy na szkolenie na realnych maszynach, z którymi kursanci spotkają się w docelowym miejscu pracy.
        </p>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Współpracujemy z zakładami produkcyjnymi, centrami logistycznymi oraz firmami wykonawczymi z województwa łódzkiego, mazowieckiego i wielkopolskiego. Szkolimy zarówno osoby indywidualne zdobywające pierwszy zawód, jak i całe działy utrzymania ruchu oraz magazyny w formule B2B.
        </p>

        <div class="pt-2 space-y-3.5">
          <div class="flex items-start gap-3 text-sm text-slate-700 leading-relaxed">
            <span class="text-emerald-600 shrink-0 mt-0.5">
              <IndustrialIcon name="check-circle" class="w-5 h-5" />
            </span>
            <div>
              <strong class="text-slate-900">Własny poligon manewrowy i biuro:</strong> Dysponujemy rampami załadunkowymi, regałami wysokiego składowania oraz poligonem ziemnym przy <strong>ul. Przemysłowej 2 w Kutnie</strong> (z bezpłatnym parkingiem). Biuro zapisów mieści się przy <strong>ul. Henryka Siemiradzkiego 18</strong>.
            </div>
          </div>
          <div class="flex items-start gap-3 text-sm text-slate-700 leading-relaxed">
            <span class="text-emerald-600 shrink-0 mt-0.5">
              <IndustrialIcon name="check-circle" class="w-5 h-5" />
            </span>
            <div>
              <strong class="text-slate-900">Instruktorzy z doświadczeniem polowym:</strong> Zajęcia prowadzą praktycy posiadający wieloletni staż operatorski, konserwatorski oraz uprawnienia pedagogiczne.
            </div>
          </div>
          <div class="flex items-start gap-3 text-sm text-slate-700 leading-relaxed">
            <span class="text-emerald-600 shrink-0 mt-0.5">
              <IndustrialIcon name="check-circle" class="w-5 h-5" />
            </span>
            <div>
              <strong class="text-slate-900">Dotacje KFS i BUR:</strong> Przygotowujemy dokumentację pozwalającą pracodawcom uzyskać od 80% do 100% dofinansowania z Krajowego Funduszu Szkoleniowego.
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="rounded-xl overflow-hidden shadow-xl border border-slate-200 bg-white">
          <img
            src="/operator-wozki-widlowe.webp"
            alt="Zajęcia praktyczne na wózku widłowym w MultiSerwis Kutno"
            width="800"
            height="500"
            loading="lazy"
            class="w-full h-80 object-cover"
          />
          <div class="p-6 bg-white">
            <h3 class="font-heading font-bold text-lg text-slate-900">Baza szkoleniowa w Kutnie</h3>
            <p class="text-sm text-slate-600 mt-1 leading-relaxed">
              Wyposażone sale wykładowe, atestowana spawalnia oraz plac manewrowy dostępne również w godzinach popołudniowych i w weekendy.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="mb-12 text-center max-w-xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Rozwój i doświadczenie</span>
        <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 mt-1">
          Kamienie milowe MultiSerwis
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {milestones.map((item) => (
          <div class="p-6 rounded-xl bg-slate-50 border border-slate-200/80 relative space-y-2.5">
            <span class="text-2xl font-heading font-black text-brand-accent block">{item.year}</span>
            <h3 class="font-heading font-bold text-slate-900 text-base">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 bg-gradient-to-r from-brand-dark to-brand-primary text-white">
    <div class="max-w-4xl mx-auto px-4 md:px-8 text-center space-y-6">
      <h2 class="text-3xl sm:text-4xl font-heading font-black">
        Zdobądź uprawnienia państwowe z gwarancją solidnego przygotowania
      </h2>
      <p class="text-slate-300 text-base max-w-xl mx-auto leading-relaxed">
        Skontaktuj się z naszym biurem w Kutnie lub wybierz interesujący Cię kurs bezpośrednio z katalogu szkoleń.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <a
          href="/szkolenia"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-brand-accent text-white font-bold text-xs uppercase tracking-wider rounded-md hover:bg-brand-accentHover transition-all shadow-lg"
        >
          Przeglądaj szkolenia
          <IndustrialIcon name="arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/kontakt"
          class="px-8 py-3.5 bg-white text-brand-dark font-bold text-xs uppercase tracking-wider rounded-md hover:bg-slate-100 transition-colors"
        >
          Skontaktuj się z nami
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
