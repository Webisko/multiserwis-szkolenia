---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { MACHINES } from "@multiserwis/shared";

const rentalBenefits = [
  {
    title: "Aktualne badania UDT",
    desc: "100% sprawności technicznej. Każda maszyna przechodzi regularne przeglądy i posiada ważną księgę rewizyjną UDT.",
    icon: "🛡️",
  },
  {
    title: "Wynajem krótko- i długoterminowy",
    desc: "Elastyczne stawki dobowe, tygodniowe oraz atrakcyjne rabaty przy kontraktach długoterminowych dla generalnych wykonawców.",
    icon: "⏱️",
  },
  {
    title: "Z operatorem lub 'na zimno'",
    desc: "Oferujemy wynajem samego sprzętu lub z certyfikowanym, doświadczonym operatorem MultiSerwis.",
    icon: "👷",
  },
  {
    title: "Własny transport niskopodwoziowy",
    desc: "Dostarczamy maszyny bezpośrednio na plac budowy w Kutnie, Łodzi, Płocku, Gostyninie i w promieniu 100 km.",
    icon: "🚛",
  },
];
---

<BaseLayout
  title="Wynajem Maszyn Budowlanych i Podnośników Kutno | MultiSerwis"
  description="Wynajem nowoczesnych ładowarek teleskopowych Manitou, zwyżek przegubowych Genie i koparko-ładowarek JCB w Kutnie. Z operatorem lub bez. Zobacz flotę."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-dark text-white py-16 md:py-24 border-b border-slate-800 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/wynajem-maszyn.webp"
        alt="Wynajem maszyn budowlanych Kutno"
        class="w-full h-full object-cover opacity-20 filter brightness-75 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/95 to-brand-primary/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl space-y-5">
        <span class="inline-block px-3.5 py-1 bg-brand-accent/20 border border-brand-accent/40 text-brand-accent text-xs font-bold uppercase tracking-wider rounded-sm">
          Flota Heavy Duty Kutno
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black text-white leading-tight">
          Wynajem Maszyn Budowlanych i Podestów Ruchomych
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Nowoczesna, niezawodna flota ładowarek obrotowych, podnośników koszowych oraz koparek do Twojej dyspozycji. Zapewniamy transport lawetą bezpośrednio na plac budowy.
        </p>

        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="tel:+48730101000"
            class="px-6 py-3.5 bg-brand-accent text-white font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-brand-accentHover transition-all shadow-lg shadow-orange-500/20"
          >
            📞 Zadzwoń po wycenę: +48 730 101 000
          </a>
          <a
            href="#katalog-maszyn"
            class="px-6 py-3.5 border border-white/30 text-white font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-white/10 transition-colors"
          >
            Przeglądaj flotę maszyn ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {rentalBenefits.map((item) => (
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-100 space-y-2">
            <span class="text-2xl block mb-1">{item.icon}</span>
            <h3 class="font-heading font-bold text-slate-900 text-sm">{item.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Machines Catalog Section -->
  <section id="katalog-maszyn" class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Dostępne jednostki</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 mt-1">
            Katalog Maszyn na Wynajem
          </h2>
        </div>
        <p class="text-xs text-slate-600 max-w-md">
          Potrzebujesz innej maszyny lub specjalistycznego osprzętu (widły, wciągarka, kosz osobowy)? Skontaktuj się z nami.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {MACHINES.map((machine) => (
          <div class="bg-white rounded-xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="h-60 bg-slate-900 overflow-hidden relative">
                <img
                  src={machine.image}
                  alt={machine.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute top-3 left-3 bg-brand-dark/90 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-sm backdrop-blur-xs">
                  {machine.type}
                </div>
              </div>

              <div class="p-6">
                <h3 class="text-xl font-heading font-bold text-slate-900 group-hover:text-brand-primary transition-colors">
                  {machine.name}
                </h3>
                <p class="text-xs font-semibold text-brand-accent uppercase tracking-wider mt-0.5 mb-4">
                  {machine.type}
                </p>

                <div class="space-y-2 border-t border-slate-100 pt-4 mb-6">
                  {Object.entries(machine.specs).map(([key, value]) => (
                    <div class="flex justify-between items-center text-xs">
                      <span class="text-slate-500 capitalize">{key}:</span>
                      <span class="font-bold text-slate-800">{value}</span>
                    </div>
                  ))}
                  <div class="flex justify-between items-center text-xs">
                    <span class="text-slate-500">Badania UDT:</span>
                    <span class="font-bold text-emerald-600">Aktualne / Po przeglądzie</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="p-6 pt-0 space-y-2 border-t border-slate-50">
              <a
                href={`/kontakt?wynajem=${encodeURIComponent(machine.name)}`}
                class="block w-full text-center py-2.5 bg-brand-primary text-white font-bold rounded-sm hover:bg-brand-dark transition-colors uppercase tracking-wider text-xs"
              >
                Zapytaj o dostępność i stawkę
              </a>
              <a
                href="tel:+48730101000"
                class="block w-full text-center py-2 text-xs font-bold text-brand-accent hover:text-brand-accentHover uppercase tracking-wider transition-colors"
              >
                Rezerwacja telefoniczna: 730 101 000
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Rental Procedure CTA -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="rounded-2xl bg-gradient-to-r from-brand-dark to-brand-primary text-white p-8 md:p-12 shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Szybka procedura</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black leading-tight">
            Wynajmij maszynę nawet w 2 godziny od kontaktu
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Minimum formalności dla firm i klientów indywidualnych. Zadzwoń, podaj lokalizację budowy i termin, a nasz transport dostarczy maszynę prosto na plac robót.
          </p>
        </div>

        <div class="shrink-0 flex flex-col sm:flex-row gap-4">
          <a
            href="tel:+48730101000"
            class="px-6 py-3.5 bg-brand-accent text-white font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-brand-accentHover transition-all shadow-md text-center"
          >
            Zadzwoń teraz
          </a>
          <a
            href="/kontakt"
            class="px-6 py-3.5 bg-white text-brand-dark font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-slate-100 transition-colors text-center"
          >
            Formularz zapytania →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
