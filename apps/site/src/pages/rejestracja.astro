---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndustrialIcon from "../components/IndustrialIcon.astro";
import { COURSES } from "@multiserwis/shared";
---

<BaseLayout
  title="Zapisz się na szkolenie stacjonarne | MultiSerwis Kutno"
  description="Wypełnij krótki formularz zapisu na certyfikowane szkolenia UDT, IMBiGS (ŚBŁ-WIT), SEP i spawalnicze w Kutnie. Rezerwacja miejsca na zajęcia w sali i placu manewrowym."
>
  <div class="bg-brand-dark text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-2xl space-y-3">
        <span class="inline-block px-3.5 py-1 bg-brand-accent/20 border border-brand-accent/40 text-brand-accent text-xs font-bold uppercase tracking-wider rounded-md">
          Ośrodek Szkolenia Kadr w Kutnie
        </span>
        <h1 class="text-3xl sm:text-4xl font-heading font-black leading-tight">
          Formularz zapisu na szkolenie
        </h1>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Wybierz kurs i zarezerwuj miejsce na najbliższe zajęcia stacjonarne w Kutnie. W dniu zapisu wystawiamy bezpłatne skierowanie na badania medycyny pracy (płatne w przychodni, stawka ok. 60 zł) oraz pomagamy skompletować dokumentację egzaminacyjną.
        </p>
      </div>
    </div>
  </div>

  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <div class="bg-white rounded-xl shadow-xl border border-slate-200 p-6 sm:p-10">
        <!-- Wybór typu uczestnika: Osoba prywatna vs Firma B2B -->
        <div class="mb-8">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-3">
            1. Rodzaj zgłoszenia
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="reg-role-selector">
            <button
              type="button"
              data-role="INDYWIDUALNY"
              class="reg-role-card text-left p-5 rounded-xl border-2 border-brand-accent bg-orange-50/40 transition-all cursor-pointer relative"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="font-heading font-extrabold text-base text-slate-900">
                  Uczestnik indywidualny
                </span>
                <span class="w-5 h-5 rounded-full border-2 border-brand-accent flex items-center justify-center">
                  <span class="reg-role-dot w-2.5 h-2.5 rounded-full bg-brand-accent"></span>
                </span>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">
                Zapis na kurs we własnym zakresie (możliwość płatności w ratach: zaliczka 500 zł, dopłata przed egzaminem).
              </p>
            </button>

            <button
              type="button"
              data-role="B2B"
              class="reg-role-card text-left p-5 rounded-xl border-2 border-slate-200 hover:border-slate-300 bg-white transition-all cursor-pointer relative"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="font-heading font-extrabold text-base text-slate-900">
                  Firma / Pracodawca (B2B)
                </span>
                <span class="w-5 h-5 rounded-full border-2 border-slate-300 flex items-center justify-center">
                  <span class="reg-role-dot w-2.5 h-2.5 rounded-full bg-transparent"></span>
                </span>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">
                Zgłoszenie pracowników z fakturą na firmę. Możliwość dofinansowania z KFS / BUR do 80–100%.
              </p>
            </button>
          </div>
        </div>

        <div
          id="reg-form-success"
          class="hidden mb-6 p-6 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-3"
        >
          <div class="flex items-center gap-2.5 text-emerald-800 font-heading font-black text-lg">
            <IndustrialIcon name="check-circle" class="w-6 h-6 text-emerald-600 shrink-0" />
            <span>Zgłoszenie zostało pomyślnie przyjęte!</span>
          </div>
          <p class="text-sm text-emerald-700 leading-relaxed">
            Dziękujemy za zapis. Nasz doradca z biura w Kutnie skontaktuje się z Tobą telefonicznie w ciągu 1–2 godzin roboczych, aby potwierdzić termin, wystawić bezpłatne skierowanie na badania medycyny pracy i omówić szczegóły organizacyjne.
          </p>
          <div class="pt-2 text-xs font-semibold text-emerald-800">
            W razie pilnych pytań zadzwoń bezpośrednio: <a href="tel:+48730101000" class="underline font-bold">+48 730 101 000</a>
          </div>
        </div>

        <form id="ms-enrollment-form" method="post" class="space-y-5">
          <input type="hidden" id="reg-role-input" name="role" value="INDYWIDUALNY" />

          <!-- Wybór kursu -->
          <div>
            <label
              for="reg-course"
              class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
            >
              2. Wybierz szkolenie *
            </label>
            <select
              id="reg-course"
              name="course"
              required
              class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 bg-white"
            >
              <option value="">-- Wybierz kurs z listy --</option>
              <optgroup label="Szkolenia UDT (Transport bliski)">
                {COURSES.filter((c) => c.category === "UDT").map((c) => (
                  <option value={`${c.title} (${c.price})`}>
                    {c.title} – {c.price} (zw. z VAT)
                  </option>
                ))}
              </optgroup>
              <optgroup label="Maszyny budowlane IMBiGS (ŚBŁ-WIT)">
                {COURSES.filter((c) => c.category === "IMBiGS").map((c) => (
                  <option value={`${c.title} (${c.price})`}>
                    {c.title} – {c.price} (zw. z VAT)
                  </option>
                ))}
              </optgroup>
              <optgroup label="Uprawnienia energetyczne SEP">
                {COURSES.filter((c) => c.category === "SEP").map((c) => (
                  <option value={`${c.title} (${c.price})`}>
                    {c.title} – {c.price}
                  </option>
                ))}
              </optgroup>
              <optgroup label="Spawalnictwo">
                {COURSES.filter((c) => c.category === "Spawalnictwo").map((c) => (
                  <option value={`${c.title} (${c.price})`}>
                    {c.title} – {c.price}
                  </option>
                ))}
              </optgroup>
              <optgroup label="BHP i specjalistyczne">
                {COURSES.filter((c) => c.category === "Inne").map((c) => (
                  <option value={`${c.title} (${c.price})`}>
                    {c.title} – {c.price}
                  </option>
                ))}
              </optgroup>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label
                for="reg-name"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
              >
                Imię i nazwisko *
              </label>
              <input
                id="reg-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                placeholder="np. Jan Kowalski"
                class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20"
              />
            </div>

            <div>
              <label
                for="reg-phone"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
              >
                Numer telefonu *
              </label>
              <input
                id="reg-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                required
                placeholder="np. +48 600 000 000"
                class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20"
              />
            </div>
          </div>

          <!-- Pole nazwy firmy i NIP (widoczne dla B2B) -->
          <div id="reg-company-wrapper" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label
                for="reg-company"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
              >
                Nazwa firmy *
              </label>
              <input
                id="reg-company"
                name="company"
                type="text"
                autocomplete="organization"
                placeholder="np. ABC Sp. z o.o."
                class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20"
              />
            </div>
            <div>
              <label
                for="reg-nip"
                class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
              >
                NIP firmy
              </label>
              <input
                id="reg-nip"
                name="nip"
                type="text"
                placeholder="np. 7751234567"
                class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20"
              />
            </div>
          </div>

          <div>
            <label
              for="reg-email"
              class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
            >
              Adres e-mail *
            </label>
            <input
              id="reg-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="np. twoj@email.pl"
              class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20"
            />
          </div>

          <div>
            <label
              for="reg-notes"
              class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2"
            >
              Preferowany termin / Uwagi dodatkowe (opcjonalnie)
            </label>
            <textarea
              id="reg-notes"
              name="notes"
              rows="3"
              placeholder="np. preferuję zajęcia w godzinach popołudniowych lub w weekendy; potrzebuję szkolenia dla 3 pracowników..."
              class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20"
            ></textarea>
          </div>

          <div class="pt-2">
            <label class="flex items-start gap-3 text-xs text-slate-600 cursor-pointer leading-relaxed">
              <input
                type="checkbox"
                required
                class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-accent focus:ring-brand-accent"
              />
              <span>
                Akceptuję <a href="/regulamin" class="text-brand-accent underline hover:text-orange-700">Regulamin świadczenia usług</a> oraz wyrażam zgodę na przetwarzanie danych osobowych przez MULTISERWIS KUTNO Sp. z o.o. w celu obsługi zapisu zgodnie z <a href="/polityka-prywatnosci" class="text-brand-accent underline hover:text-orange-700">Polityką prywatności</a>. *
              </span>
            </label>
          </div>

          <button
            type="submit"
            id="reg-submit-btn"
            class="w-full py-4 px-6 bg-brand-accent hover:bg-brand-accentHover text-white font-bold uppercase tracking-wider text-xs sm:text-sm rounded-md shadow-lg shadow-orange-500/20 transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Wyślij zgłoszenie na szkolenie</span>
            <IndustrialIcon name="arrow-right" class="w-4 h-4" />
          </button>
        </form>

        <div class="mt-8 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-600">
          <div class="flex items-center gap-2">
            <IndustrialIcon name="phone" class="w-4 h-4 text-brand-accent" />
            <span>Wolisz zapisać się telefonicznie?</span>
          </div>
          <a
            href="tel:+48730101000"
            class="inline-flex items-center gap-1.5 font-bold text-brand-primary hover:text-brand-accent transition-colors"
          >
            <span>Zadzwoń: +48 730 101 000</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const roleCards = document.querySelectorAll(".reg-role-card");
  const roleInput = document.getElementById("reg-role-input") as HTMLInputElement | null;
  const companyWrapper = document.getElementById("reg-company-wrapper");
  const companyInput = document.getElementById("reg-company") as HTMLInputElement | null;
  const courseSelect = document.getElementById("reg-course") as HTMLSelectElement | null;
  const form = document.getElementById("ms-enrollment-form") as HTMLFormElement | null;
  const successBox = document.getElementById("reg-form-success");
  const submitBtn = document.getElementById("reg-submit-btn") as HTMLButtonElement | null;

  // Auto-fill course from query parameter (?kurs=...)
  const params = new URLSearchParams(window.location.search);
  const kursParam = params.get("kurs");
  if (kursParam && courseSelect) {
    for (let i = 0; i < courseSelect.options.length; i++) {
      if (courseSelect.options[i].text.toLowerCase().includes(kursParam.toLowerCase())) {
        courseSelect.selectedIndex = i;
        break;
      }
    }
  }

  roleCards.forEach((card) => {
    card.addEventListener("click", () => {
      const selectedRole = card.getAttribute("data-role") || "INDYWIDUALNY";
      if (roleInput) roleInput.value = selectedRole;

      roleCards.forEach((c) => {
        const isActive = c === card;
        c.classList.toggle("border-brand-accent", isActive);
        c.classList.toggle("bg-orange-50/40", isActive);
        c.classList.toggle("border-slate-200", !isActive);
        c.classList.toggle("bg-white", !isActive);

        const dot = c.querySelector(".reg-role-dot");
        const ring = dot?.parentElement;
        if (dot && ring) {
          ring.classList.toggle("border-brand-accent", isActive);
          ring.classList.toggle("border-slate-300", !isActive);
          dot.classList.toggle("bg-brand-accent", isActive);
          dot.classList.toggle("bg-transparent", !isActive);
        }
      });

      if (companyWrapper && companyInput) {
        if (selectedRole === "B2B") {
          companyWrapper.classList.remove("hidden");
          companyInput.required = true;
        } else {
          companyWrapper.classList.add("hidden");
          companyInput.required = false;
        }
      }
    });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    const formData = new FormData(form);
    const role = String(formData.get("role") || "INDYWIDUALNY");
    const course = String(formData.get("course") || "");
    const name = String(formData.get("name") || "").trim();
    const phone = String(formData.get("phone") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const company = String(formData.get("company") || "").trim();
    const nip = String(formData.get("nip") || "").trim();
    const notes = String(formData.get("notes") || "").trim();

    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = "Wysyłanie zgłoszenia...";

    const messageLines = [
      `[ZAPIS NA SZKOLENIE STACJONARNE]`,
      `Wybrany kurs: ${course}`,
      `Typ zgłoszenia: ${role === "B2B" ? "Firma (B2B)" : "Osoba prywatna"}`,
      company ? `Firma: ${company} (NIP: ${nip || "brak"})` : "",
      notes ? `Uwagi / preferowany termin: ${notes}` : "",
    ].filter(Boolean).join("\n");

    try {
      await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: company ? `${name} (${company})` : name,
          phone,
          email,
          message: messageLines,
        }),
      });
    } catch {
      // Fallback
    } finally {
      if (successBox) {
        successBox.classList.remove("hidden");
        form.classList.add("hidden");
        successBox.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }
  });
</script>
