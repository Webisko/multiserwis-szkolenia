---
import CategoryLayout, { type TrainingItem } from "../../layouts/CategoryLayout.astro";

const weldingTrainings: TrainingItem[] = [
  {
    id: "spawanie-mig-mag",
    courseSlug: "spawanie",
    title: "Spawanie MIG/MAG (131, 135, 136)",
    price: "od 2 400 zł / moduł",
    description: "Najpopularniejsza metoda spawania w osłonie gazów aktywnych (MAG) lub obojętnych (MIG). Stal czarna, nierdzewna i aluminium.",
    features: ["Stal czarna: 2400 zł | Nierdzewna: 2700 zł | Alu: 2900 zł", "3 moduły: pachwiny (I), blachy (II), rury (III)", "Czas trwania: 32 godz. zajęć praktycznych", "Norma PN-EN ISO 9606-1 + Certyfikat SGS"],
  },
  {
    id: "spawanie-tig",
    courseSlug: "spawanie",
    title: "Spawanie TIG (141)",
    price: "od 2 400 zł / moduł",
    description: "Metoda 141 – spawanie elektrodą wolframową w osłonie argonu. Najwyższa jakość i estetyka spoin w instalacjach i rurociągach.",
    features: ["Stal czarna: 2400 zł | Nierdzewna: 2700 zł | Alu: 2900 zł", "Spawanie rur cienkościennych i zbiorników", "Czas trwania: 32 godz. intensywnej praktyki", "Książeczka Spawacza + Certyfikat SGS"],
  },
  {
    id: "spawanie-elektryczne",
    courseSlug: "spawanie",
    title: "Spawanie elektryczne MMA (111)",
    price: "od 2 400 zł / moduł",
    description: "Metoda 111 – spawanie elektrodą otuloną. Uniwersalna metoda montażowa na budowach i przy pracach w terenie.",
    features: ["Stal czarna: 2400 zł | Stal nierdzewna: 2700 zł", "Wszystkie pozycje spawania (PA, PB, PC, PF)", "Czas trwania: 32 godz. zajęć praktycznych", "Świadectwo egzaminu spawacza wg ISO 9606-1"],
  },
  {
    id: "odnowienie-spawanie",
    title: "Odnowienie uprawnień i cięcie termiczne",
    price: "od 600 zł",
    description: "Egzaminy weryfikacyjne przedłużające ważność certyfikatów spawalniczych oraz kursy cięcia tlenowego i plazmowego.",
    features: ["Odnowienie uprawnień spawacza: 600 zł", "Cięcie gazowe i plazmowe: 900 zł", "Egzamin weryfikacyjny przed komisją", "Przedłużenie certyfikatu na kolejne 2-3 lata"],
  },
];
---

<CategoryLayout
  title="Kursy Spawalnicze (MIG, MAG, TIG, MMA) Kutno"
  badge="Certyfikacja SGS & PN-EN ISO 9606-1"
  description="Praktyczne kursy spawania na nowoczesnych stanowiskach w Kutnie. Zdobądź międzynarodową Książeczkę Spawacza oraz certyfikat zgodny z europejską normą PN-EN ISO 9606-1 (SGS)."
  trainings={weldingTrainings}
  heroImage="/wynajem-maszyn.webp"
  servicePromo={{
    title: "Naprawy spawalnicze maszyn budowlanych",
    description: "Prowadzimy profesjonalny serwis spawalniczy: regeneracja ram, wysięgników koparek, łyżek i osprzętu ciężkiego.",
    linkText: "Poznaj ofertę serwisu maszyn",
    linkUrl: "/uslugi",
  }}
>
  <!-- Tabela szczegółowa modułów ze starej strony -->
  <div class="mt-14 bg-white rounded-2xl border border-slate-200/90 p-6 md:p-8 shadow-sm">
    <div class="mb-6">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Cennik Modułowy PN-EN ISO 9606-1</span>
      <h3 class="text-xl md:text-2xl font-heading font-black text-slate-900 mt-1">
        Kompletny Cennik Kursów Spawalniczych w podziale na Moduły
      </h3>
      <p class="text-xs md:text-sm text-slate-600 mt-1">
        Szkolenia prowadzimy w 3 modułach zaawansowania. Czas trwania modułu: 32 godziny intensywnych zajęć praktycznych. Po zdanym egzaminie kursant otrzymuje Świadectwo Egzaminu Spawacza oraz Książeczkę Spawacza (Certyfikacja SGS, ważność 2–3 lata). Ceny zwolnione z VAT.
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm border-collapse">
        <thead>
          <tr class="bg-slate-900 text-white font-heading font-bold text-xs uppercase tracking-wider">
            <th class="p-3.5 rounded-tl-lg">Metoda spawania i materiał</th>
            <th class="p-3.5 text-center">Moduł I<br /><span class="text-[10px] font-normal text-slate-300">Pachwinowe blach i rur</span></th>
            <th class="p-3.5 text-center">Moduł II<br /><span class="text-[10px] font-normal text-slate-300">Doczołowe blach</span></th>
            <th class="p-3.5 text-center rounded-tr-lg">Moduł III<br /><span class="text-[10px] font-normal text-slate-300">Doczołowe rur</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-slate-700">
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3.5 font-bold text-slate-900">Stal czarna – MMA 111 (elektroda otulona)</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3.5 font-bold text-slate-900">Stal czarna – MAG 135 (drut lity)</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3.5 font-bold text-slate-900">Stal czarna – MAG 136 (drut proszkowy)</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3.5 font-bold text-slate-900">Stal czarna – TIG 141 (elektroda wolframowa)</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 400 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors bg-slate-50/50">
            <td class="p-3.5 font-bold text-slate-900">Stal nierdzewna – MMA 111</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors bg-slate-50/50">
            <td class="p-3.5 font-bold text-slate-900">Stal nierdzewna – MAG 135</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors bg-slate-50/50">
            <td class="p-3.5 font-bold text-slate-900">Stal nierdzewna – TIG 141</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 700 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3.5 font-bold text-slate-900">Aluminium – MIG 131</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 900 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 900 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 900 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3.5 font-bold text-slate-900">Aluminium – TIG 141</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 900 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 900 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 900 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3.5 font-bold text-slate-900">Stal czarna – Spawanie gazowe 311</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 000 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 000 zł</td>
            <td class="p-3.5 text-center font-semibold text-brand-primary">2 300 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors bg-orange-50/60 font-bold text-slate-900">
            <td class="p-3.5">Odnowienie uprawnień spawacza (weryfikacja próbek)</td>
            <td colspan="3" class="p-3.5 text-center text-brand-accent text-base font-black">600 zł</td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors bg-orange-50/60 font-bold text-slate-900">
            <td class="p-3.5">Cięcie gazowe (acetylen-tlen / propan-tlen) i plazmowe</td>
            <td colspan="3" class="p-3.5 text-center text-brand-accent text-base font-black">900 zł</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-6 pt-5 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <div>
        <strong>Wymagania formalne:</strong> Ukończone 18 lat, wykształcenie minimum podstawowe, zaświadczenie lekarskie medycyny pracy (ośrodek wydaje skierowanie).
      </div>
      <a
        href="/kontakt?kurs=spawanie_modulowe"
        class="shrink-0 px-5 py-2.5 bg-brand-primary hover:bg-brand-secondary text-white font-bold rounded-sm uppercase tracking-wider transition-colors"
      >
        Zapisz się na moduł spawalniczy →
      </a>
    </div>
  </div>
</CategoryLayout>
