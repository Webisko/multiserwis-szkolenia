---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IndustrialIcon from "../../components/IndustrialIcon.astro";
import { COURSES } from "@multiserwis/shared";
import { slugify } from "../../utils/slug";

export async function getStaticPaths() {
  const paths: { params: { slug: string }; props: { course: typeof COURSES[0] } }[] = [];
  
  for (const course of COURSES) {
    if (course.slug) {
      paths.push({ params: { slug: course.slug }, props: { course } });
    }
    const titleSlug = slugify(course.title);
    if (titleSlug && titleSlug !== course.slug) {
      paths.push({ params: { slug: titleSlug }, props: { course } });
    }
  }
  
  return paths;
}

const { course } = Astro.props;

const categorySlugMap: Record<string, string> = {
  UDT: "/szkolenia/udt",
  IMBiGS: "/szkolenia/imbigs",
  SEP: "/szkolenia/sep",
  Spawalnictwo: "/szkolenia/spawalnictwo",
  Inne: "/szkolenia/pozostale",
};
const categoryUrl = categorySlugMap[course.category] || "/szkolenia";

const syllabusMap: Record<string, string[]> = {
  UDT: [
    "Wiadomości o dozorze technicznym i obowiązujące przepisy prawne",
    "Budowa i parametry techniczne urządzeń transportu bliskiego",
    "Czynności operatora przed rozpoczęciem, w trakcie i po zakończeniu pracy",
    "Stateczność urządzenia, diagramy udźwigu i środki ciężkości ładunku",
    "Mechanizmy napędowe, układy hydrauliczne i instalacje elektryczne",
    "Bezpieczna wymiana butli gazowych LPG (wózki jezdniowe)",
    "Praktyczna obsługa maszyny na placu manewrowym w Kutnie",
    "Symulacja egzaminu państwowego UDT pod okiem instruktora",
  ],
  IMBiGS: [
    "Ogólna budowa i zasada działania maszyn do robót ziemnych i drogowych",
    "Technologia wykonywania wykopów, nasypów i plantowania terenu",
    "Układy hydrauliczne wysokociśnieniowe i sterowanie wieloczynnościowe",
    "Bezpieczeństwo pracy przy eksploatacji maszyn w pobliżu instalacji podziemnych",
    "Obsługa codzienna (OTC), smarowanie i bezpieczna wymiana osprzętu roboczego",
    "Jazdy praktyczne i manewrowanie maszyną na poligonie przy ul. Przemysłowej 2",
    "Przygotowanie do egzaminu państwowego przed komisją ŚBŁ-WIT (dawniej IMBiGS)",
  ],
  SEP: [
    "Podstawowe pojęcia elektrotechniki i przepisy prawa energetycznego",
    "Ochrona przeciwporażeniowa: środki ochrony podstawowej i przy uszkodzeniu",
    "Budowa, zasada działania i eksploatacja urządzeń do i powyżej 1 kV",
    "Aparatura łączeniowa, zabezpieczająca i pomiarowo-kontrolna",
    "Zasady organizacji bezpiecznej pracy przy urządzeniach energetycznych",
    "Postępowanie w razie porażenia prądem elektrycznym i zasady pierwszej pomocy",
    "Egzamin kwalifikacyjny przed Państwową Komisją Kwalifikacyjną",
  ],
  Spawalnictwo: [
    "Zasady BHP i ochrony przeciwpożarowej przy pracach spawalniczych",
    "Dobór parametrów spawania, gazów osłonowych oraz materiałów dodatkowych",
    "Przygotowanie krawędzi blach i rur do spawania pachwinowego i doczołowego",
    "Praktyczne spawanie w pozycjach podolnych, naściennych i pionowych (PA, PB, PC, PF)",
    "Identyfikacja niezgodności spawalniczych i metody zapobiegania odkształceniom",
    "Badania wizualne (VT) i łamanie wykonanych złączy próbnych",
    "Egzamin końcowy i certyfikacja spawalnicza wg PN-EN ISO 9606-1 (SGS)",
  ],
  Inne: [
    "Przepisy BHP i normy techniczne obowiązujące na stanowisku pracy",
    "Budowa, zasada działania i kryteria bezpiecznej eksploatacji sprzętu",
    "Identyfikacja zużycia eksploatacyjnego, uszkodzeń mechanicznych i kryteriów brakowania",
    "Zasady bezpiecznego wykonywania czynności roboczych i stosowania środków ochrony indywidualnej",
    "Czynności konserwacyjne i kontrolne przed rozpoczęciem oraz po zakończeniu pracy",
    "Ćwiczenia praktyczne na stanowisku szkoleniowym pod nadzorem instruktora",
    "Sprawdzenie wiedzy i wydanie imiennego zaświadczenia kwalifikacyjnego",
  ],
};

const syllabus = syllabusMap[course.category] || syllabusMap["UDT"];

const numericPrice = course.price.replace(/[^\d]/g, "");

const courseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Course",
    name: course.title,
    description: course.description,
    provider: {
      "@type": "EducationalOrganization",
      name: "Ośrodek Szkolenia Kadr MultiSerwis",
      sameAs: "https://multiserwis.edu.pl",
    },
    offers: numericPrice
      ? {
          "@type": "Offer",
          price: numericPrice,
          priceCurrency: "PLN",
          availability: "https://schema.org/InStock",
          url: `https://multiserwis.edu.pl/szkolenia/${course.slug || slugify(course.title)}`,
        }
      : undefined,
    hasCourseInstance: {
      "@type": "CourseInstance",
      courseMode: course.hasOnline ? ["Blended", "Online", "OnSite"] : ["OnSite"],
      location: {
        "@type": "Place",
        name: "Poligon Szkoleniowy MultiSerwis Kutno",
        address: {
          "@type": "PostalAddress",
          streetAddress: "ul. Przemysłowa 2",
          addressLocality: "Kutno",
          postalCode: "99-300",
          addressCountry: "PL",
        },
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Start",
        item: "https://multiserwis.edu.pl/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Szkolenia",
        item: "https://multiserwis.edu.pl/szkolenia",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: course.category,
        item: `https://multiserwis.edu.pl${categoryUrl}`,
      },
      {
        "@type": "ListItem",
        position: 4,
        name: course.title,
        item: `https://multiserwis.edu.pl/szkolenia/${course.slug || slugify(course.title)}`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${course.title} Kutno – kurs i egzamin | MultiSerwis`}
  description={`Zdobądź uprawnienia: ${course.title} w Kutnie. ${course.hasOnline ? "Teoria online 24/7, " : ""}praktyka na placu manewrowym przy ul. Przemysłowej 2, egzamin państwowy. Cena: ${course.price} (zw. z VAT).`}
  schema={courseSchema}
>
  <!-- Breadcrumbs & Category Bar -->
  <div class="bg-slate-900 border-b border-slate-800 text-xs py-3 px-4 md:px-8">
    <div class="max-w-7xl mx-auto flex items-center gap-2 text-slate-400">
      <a href="/" class="hover:text-white transition-colors">Start</a>
      <span>/</span>
      <a href="/szkolenia" class="hover:text-white transition-colors">Szkolenia</a>
      <span>/</span>
      <a href={categoryUrl} class="text-brand-accent hover:underline">
        {course.category}
      </a>
      <span>/</span>
      <span class="text-slate-200 truncate">{course.title}</span>
    </div>
  </div>

  <!-- Course Hero Banner -->
  <section class="relative bg-brand-dark text-white py-14 md:py-20 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={course.image}
        alt={course.title}
        width="1400"
        height="800"
        class="w-full h-full object-cover opacity-25 filter brightness-50"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/95 to-brand-primary/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-8 grid lg:grid-cols-[1.3fr_0.7fr] gap-12 items-center">
      <div class="space-y-6">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="px-3 py-1 bg-brand-accent/20 border border-brand-accent/50 text-brand-accent text-xs font-bold uppercase tracking-wider rounded-md">
            Kategoria: {course.category}
          </span>
          {course.hasOnline && (
            <span class="px-3 py-1 bg-emerald-500/20 border border-emerald-500/50 text-emerald-400 text-xs font-bold uppercase tracking-wider rounded-md">
              E-learning 24/7
            </span>
          )}
          {course.isPopular && (
            <span class="px-3 py-1 bg-blue-500/20 border border-blue-500/50 text-blue-300 text-xs font-bold uppercase tracking-wider rounded-md">
              Wysokie zapotrzebowanie
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-black text-white leading-tight">
          {course.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
          {course.description}
        </p>

        <!-- Quick Meta Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 text-xs">
          <div class="bg-white/10 backdrop-blur-sm p-3.5 rounded-lg border border-white/10">
            <span class="text-slate-300 block uppercase font-semibold text-xs">Czas trwania</span>
            <span class="text-base font-bold text-white mt-0.5 block">{course.duration}</span>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-3.5 rounded-lg border border-white/10">
            <span class="text-slate-300 block uppercase font-semibold text-xs">Egzamin i praktyka</span>
            <span class="text-base font-bold text-emerald-400 mt-0.5 block">Poligon w Kutnie</span>
          </div>
          <div class="bg-white/10 backdrop-blur-sm p-3.5 rounded-lg border border-white/10 col-span-2 sm:col-span-1">
            <span class="text-slate-300 block uppercase font-semibold text-xs">Tryb szkolenia</span>
            <span class="text-base font-bold text-white mt-0.5 block">{course.hasOnline ? "Online + praktyka" : "Stacjonarny / praktyka"}</span>
          </div>
        </div>
      </div>

      <!-- Conversion Checkout Box -->
      <div class="bg-white text-slate-900 rounded-xl shadow-2xl p-6 sm:p-8 border border-slate-200">
        <div class="border-b border-slate-100 pb-5 mb-5">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Koszt szkolenia</span>
          <div class="flex items-baseline gap-2 mt-1 flex-wrap">
            <span class="text-3xl sm:text-4xl font-heading font-black text-brand-primary">{course.price}</span>
            <span class="text-xs text-slate-500 font-semibold">zw. z VAT / os.</span>
          </div>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Cena obejmuje wykłady, zajęcia praktyczne na maszynach, materiały dydaktyczne oraz obsługę wniosku egzaminacyjnego.
          </p>
        </div>

        <div class="space-y-3 mb-6 text-sm text-slate-700">
          <div class="flex items-center gap-2.5">
            <span class="text-emerald-600 shrink-0"><IndustrialIcon name="check-circle" class="w-4 h-4" /></span>
            <span>{course.hasOnline ? "Dostęp do panelu e-learningowego od ręki" : "Zajęcia pod okiem certyfikowanych instruktorów"}</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-emerald-600 shrink-0"><IndustrialIcon name="check-circle" class="w-4 h-4" /></span>
            <span>Indywidualnie dopasowane godziny jazd praktycznych</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-emerald-600 shrink-0"><IndustrialIcon name="check-circle" class="w-4 h-4" /></span>
            <span>Możliwość dofinansowania z KFS / BUR (do 80–100%)</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-emerald-600 shrink-0"><IndustrialIcon name="check-circle" class="w-4 h-4" /></span>
            <span>Państwowe zaświadczenie kwalifikacyjne honorowane w UE</span>
          </div>
        </div>

        <div class="space-y-3">
          <a
            href={`/kontakt?kurs=${encodeURIComponent(course.title)}`}
            class="inline-flex items-center justify-center gap-2 w-full text-center py-3.5 bg-brand-accent text-white font-bold text-xs uppercase tracking-wider rounded-md hover:bg-brand-accentHover transition-all shadow-lg shadow-orange-500/20"
          >
            Zapisz się na to szkolenie
            <IndustrialIcon name="arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="tel:+48730101000"
            class="inline-flex items-center justify-center gap-2 w-full text-center py-3 border border-slate-300 text-slate-700 font-bold text-xs uppercase tracking-wider rounded-md hover:bg-slate-50 transition-colors"
          >
            <IndustrialIcon name="phone" class="w-4 h-4 text-brand-primary" />
            Zadzwoń: +48 730 101 000
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Course Information Blocks -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-8 grid lg:grid-cols-[1.3fr_0.7fr] gap-12">
      <!-- Left Column: Syllabus & Details -->
      <div class="space-y-12">
        <!-- Syllabus Block -->
        <div class="bg-white rounded-xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Ramowy plan nauczania</span>
          <h2 class="text-2xl font-heading font-black text-slate-900 mt-1 mb-6">
            Program szkolenia i zagadnienia praktyczne
          </h2>

          <div class="space-y-3">
            {syllabus.map((item, idx) => (
              <div class="flex items-start gap-3.5 p-3.5 rounded-lg bg-slate-50 border border-slate-100">
                <span class="w-6 h-6 rounded-md bg-brand-primary text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <span class="text-sm text-slate-800 font-medium leading-relaxed">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Requirements Block -->
        <div class="bg-white rounded-xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Warunki uczestnictwa</span>
          <h2 class="text-2xl font-heading font-black text-slate-900 mt-1 mb-6">
            Wymagania wstępne dla kandydatów
          </h2>

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-lg bg-slate-50 border border-slate-100 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                <IndustrialIcon name="user-age" class="w-5 h-5" />
              </div>
              <div>
                <strong class="text-slate-900 block font-bold text-sm">Wiek</strong>
                <span class="text-sm text-slate-600 leading-relaxed">Ukończone 18 lat najpóźniej w dniu przystąpienia do egzaminu.</span>
              </div>
            </div>
            <div class="p-4 rounded-lg bg-slate-50 border border-slate-100 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                <IndustrialIcon name="graduation" class="w-5 h-5" />
              </div>
              <div>
                <strong class="text-slate-900 block font-bold text-sm">Wykształcenie</strong>
                <span class="text-sm text-slate-600 leading-relaxed">Minimum podstawowe lub gimnazjalne.</span>
              </div>
            </div>
            <div class="p-4 rounded-lg bg-slate-50 border border-slate-100 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                <IndustrialIcon name="medical" class="w-5 h-5" />
              </div>
              <div>
                <strong class="text-slate-900 block font-bold text-sm">Stan zdrowia</strong>
                <span class="text-sm text-slate-600 leading-relaxed">Brak przeciwwskazań zdrowotnych – w dniu zapisu wystawiamy bezpłatne skierowanie na badania medycyny pracy (płatne w przychodni, stawka ok. 60 zł).</span>
              </div>
            </div>
            <div class="p-4 rounded-lg bg-slate-50 border border-slate-100 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-lg bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                <IndustrialIcon name="id-card" class="w-5 h-5" />
              </div>
              <div>
                <strong class="text-slate-900 block font-bold text-sm">Prawo jazdy</strong>
                <span class="text-sm text-slate-600 leading-relaxed">Niewymagane do pracy na terenie zakładu lub placu budowy (konieczne tylko na drogach publicznych).</span>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ Block -->
        <div class="bg-white rounded-xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Najczęstsze pytania</span>
          <h2 class="text-2xl font-heading font-black text-slate-900 mt-1 mb-6">
            Organizacja kursu i egzaminu
          </h2>

          <div class="space-y-4">
            <details class="group border border-slate-200 rounded-lg p-4 cursor-pointer">
              <summary class="font-bold text-slate-900 text-sm sm:text-base flex justify-between items-center gap-4 list-none">
                <span>Jak wygląda organizacja zajęć i jak ustalane są terminy jazd?</span>
                <span class="text-brand-accent group-open:rotate-180 transition-transform shrink-0">
                  <IndustrialIcon name="chevron-down" class="w-4 h-4" />
                </span>
              </summary>
              <p class="text-sm text-slate-600 mt-3 leading-relaxed border-t border-slate-100 pt-3">
                Szkolenia prowadzimy w formule naboru ciągłego – nowe grupy ruszają w każdy poniedziałek. Teorię prowadzimy w klimatyzowanej sali wykładowej przy ul. Siemiradzkiego 18, a harmonogram jazd na placu manewrowym przy ul. Przemysłowej 2 ustalamy w każdy piątek na nadchodzący tydzień, elastycznie dopasowując godziny do dyspozycyjności kursantów.
              </p>
            </details>

            <details class="group border border-slate-200 rounded-lg p-4 cursor-pointer">
              <summary class="font-bold text-slate-900 text-sm sm:text-base flex justify-between items-center gap-4 list-none">
                <span>Czy muszę mieć własne badania lekarskie przed zapisem?</span>
                <span class="text-brand-accent group-open:rotate-180 transition-transform shrink-0">
                  <IndustrialIcon name="chevron-down" class="w-4 h-4" />
                </span>
              </summary>
              <p class="text-sm text-slate-600 mt-3 leading-relaxed border-t border-slate-100 pt-3">
                Nie, nie musisz załatwiać badań przed wizytą w biurze. W dniu zapisu na kurs wystawiamy bezpłatne skierowanie do przychodni medycyny pracy. Koszt badania pokrywany jest w przychodni (stawka wynosi ok. 60 zł).
              </p>
            </details>

            <details class="group border border-slate-200 rounded-lg p-4 cursor-pointer">
              <summary class="font-bold text-slate-900 text-sm sm:text-base flex justify-between items-center gap-4 list-none">
                <span>Gdzie odbywają się jazdy praktyczne oraz egzamin państwowy?</span>
                <span class="text-brand-accent group-open:rotate-180 transition-transform shrink-0">
                  <IndustrialIcon name="chevron-down" class="w-4 h-4" />
                </span>
              </summary>
              <p class="text-sm text-slate-600 mt-3 leading-relaxed border-t border-slate-100 pt-3">
                Zajęcia praktyczne i egzaminy państwowe przed komisją UDT lub ŚBŁ-WIT (IMBiGS) organizujemy na naszym poligonie manewrowym przy ul. Przemysłowej 2 w Kutnie, dokładnie na tych samych maszynach, na których uczysz się podczas kursu.
              </p>
            </details>

            <details class="group border border-slate-200 rounded-lg p-4 cursor-pointer">
              <summary class="font-bold text-slate-900 text-sm sm:text-base flex justify-between items-center gap-4 list-none">
                <span>Czy ośrodek załatwia formalności związane ze zgłoszeniem na egzamin?</span>
                <span class="text-brand-accent group-open:rotate-180 transition-transform shrink-0">
                  <IndustrialIcon name="chevron-down" class="w-4 h-4" />
                </span>
              </summary>
              <p class="text-sm text-slate-600 mt-3 leading-relaxed border-t border-slate-100 pt-3">
                Tak, biuro MultiSerwis kompletuje pełną dokumentację, składa wnioski egzaminacyjne do właściwej komisji (UDT, ŚBŁ-WIT, SEP, SGS) oraz informuje kursanta SMS-em i telefonicznie o wyznaczonym terminie egzaminu.
              </p>
            </details>
          </div>
        </div>
      </div>

      <!-- Right Column: Training Facility & Contact -->
      <div class="space-y-8">
        <!-- Location Card -->
        <div class="bg-white rounded-xl border border-slate-200/80 p-6 shadow-sm">
          <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">Baza szkoleniowa MultiSerwis</h3>
          <p class="text-sm text-slate-600 mb-4 leading-relaxed">
            Zajęcia praktyczne oraz egzaminy państwowe prowadzimy na certyfikowanym poligonie w Kutnie:
          </p>
          <div class="bg-slate-50 p-4 rounded-lg border border-slate-100 text-sm space-y-3 mb-5">
            <div class="flex items-start gap-2.5">
              <IndustrialIcon name="pin" class="w-4 h-4 text-brand-accent shrink-0 mt-0.5" />
              <div>
                <div class="font-bold text-slate-900">Poligon: ul. Przemysłowa 2, 99-300 Kutno</div>
                <div class="text-xs text-slate-600 mt-0.5">Plac manewrowy z rampami, wykopami technologicznymi i halą wysokiego składowania.</div>
              </div>
            </div>
            <div class="flex items-start gap-2.5 pt-2 border-t border-slate-200/70">
              <IndustrialIcon name="building" class="w-4 h-4 text-brand-primary shrink-0 mt-0.5" />
              <div>
                <div class="font-bold text-slate-900">Biuro: ul. Henryka Siemiradzkiego 18</div>
