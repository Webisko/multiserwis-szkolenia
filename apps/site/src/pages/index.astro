---
import BaseLayout from "../layouts/BaseLayout.astro";
import IndustrialIcon, { type IconName } from "../components/IndustrialIcon.astro";

const categories: { title: string; icon: IconName; desc: string; href: string; count: string }[] = [
  {
    title: "Uprawnienia UDT",
    icon: "forklift",
    desc: "Wózki widłowe, ładowarki teleskopowe, podesty ruchome (zwyżki), suwnice i żurawie HDS.",
    href: "/szkolenia/udt",
    count: "7 kursów",
  },
  {
    title: "Maszyny IMBiGS",
    icon: "excavator",
    desc: "Koparko-ładowarki, koparki jednonaczyniowe, ładowarki, walce drogowe i spycharki.",
    href: "/szkolenia/imbigs",
    count: "9 kursów",
  },
  {
    title: "Uprawnienia SEP",
    icon: "sep",
    desc: "Grupy G1 (elektryczne), G2 (cieplne), G3 (gazowe) na stanowiskach Eksploatacji (E) i Dozoru (D).",
    href: "/szkolenia/sep",
    count: "3 grupy",
  },
  {
    title: "Spawalnictwo",
    icon: "welding",
    desc: "Metody MIG/MAG (131/135/136), TIG (141), MMA (111). Certyfikat SGS wg PN-EN ISO 9606-1.",
    href: "/szkolenia/spawalnictwo",
    count: "4 metody",
  },
  {
    title: "BHP i specjalistyczne",
    icon: "bhp",
    desc: "Kontrola zawiesi, pilarki mechaniczne, kosy spalinowe, windy samochodowe i hakowy-sygnalista.",
    href: "/szkolenia/pozostale",
    count: "6 kursów",
  },
];

const steps: { step: string; title: string; desc: string; icon: IconName }[] = [
  {
    step: "01",
    title: "Zapis online lub telefoniczny",
    desc: "Wybierasz kurs i rezerwujesz miejsce w 60 sekund. Pomagamy skompletować wniosek egzaminacyjny oraz badania lekarskie.",
    icon: "id-card",
  },
  {
    step: "02",
    title: "Wykłady i teoria w Kutnie",
    desc: "Uczestniczysz w merytorycznych zajęciach w naszej sali wykładowej (ul. Siemieradzkiego 18) i poznajesz oficjalne pytania egzaminacyjne.",
    icon: "building",
  },
  {
    step: "03",
    title: "Jazdy na placu w Kutnie",
    desc: "Ćwiczysz manewrowanie pod okiem instruktora na naszym poligonie przy ul. Przemysłowej 2 w elastycznych godzinach.",
    icon: "forklift",
  },
  {
    step: "04",
    title: "Egzamin państwowy na miejscu",
    desc: "Zdajesz egzamin przed komisją UDT, ŚBŁ-WIT lub SEP dokładnie na tej samej maszynie, na której uczyłeś się jeździć.",
    icon: "award",
  },
];

const upcomingDates = [
  {
    title: "Operator wózków widłowych (UDT) + egzamin",
    category: "UDT",
    scheduleInfo: "Wykłady w Kutnie • Jazdy na placu (ul. Przemysłowa 2)",
    spots: "4 wolne miejsca",
    price: "1 000 zł",
    href: "/szkolenia/wozki-widlowe",
  },
  {
    title: "Ładowarki teleskopowe i wózki podnoszone (UDT)",
    category: "UDT",
    scheduleInfo: "Wykłady w Kutnie • Jazdy na placu (ul. Przemysłowa 2)",
    spots: "3 wolne miejsca",
    price: "1 500 zł",
    href: "/szkolenia/ladowarki-teleskopowe",
  },
  {
    title: "Uprawnienia elektryczne SEP G1 (Eksploatacja + Dozór)",
    category: "SEP",
    scheduleInfo: "Kurs 1-dniowy w Kutnie + egzamin komisji kwalifikacyjnej",
    spots: "Zapisy otwarte",
    price: "860 zł / upr.",
    href: "/szkolenia/sep-g1",
  },
];

const homeFaqs = [
  {
    q: "Jak długo czeka się na egzamin państwowy UDT w Kutnie?",
    a: "Czas oczekiwania na wyznaczenie komisji egzaminacyjnej Urzędu Dozoru Technicznego wynosi ustawowo do 30 dni roboczych od złożenia wniosku. Wszystkie formalności i zgłoszenia realizuje w Twoim imieniu biuro MultiSerwis.",
  },
  {
    q: "Czy teoria online zwalnia z przyjazdu na wykłady stacjonarne?",
    a: "Tak. Korzystając z naszej platformy e-learningowej dostępnej 24/7, przerabiasz materiał teoretyczny oraz oficjalne testy egzaminacyjne w domu. Do bazy szkoleniowej przy ul. Przemysłowej 2 w Kutnie przyjeżdżasz wyłącznie na jazdy praktyczne oraz egzamin państwowy.",
  },
  {
    q: "Czy za szkolenie można zapłacić w ratach lub uzyskać dofinansowanie?",
    a: "Tak. Umożliwiamy rozłożenie płatności na nieoprocentowane raty (zaliczka 500 zł przy zapisie, dopłata do 3 dni przed egzaminem). Dla pracodawców i firm pomagamy również w uzyskaniu do 100% dofinansowania z Krajowego Funduszu Szkoleniowego (KFS) oraz Bazy Usług Rozwojowych (BUR).",
  },
  {
    q: "Czy zdobyte uprawnienia UDT i IMBiGS są ważne za granicą?",
    a: "Tak, państwowe zaświadczenia kwalifikacyjne UDT, ŚBŁ-WIT (IMBiGS), SEP oraz certyfikaty spawalnicze wg normy PN-EN ISO 9606-1 są honorowane na terenie całej Unii Europejskiej. Na życzenie wydajemy również suplement w języku angielskim.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<BaseLayout
  title="MultiSerwis Kutno | Kursy i szkolenia UDT, IMBiGS, SEP • Wynajem maszyn"
  description="Zdobądź uprawnienia operatora UDT, IMBiGS i SEP w Kutnie. Wykłady w sali szkoleniowej, intensywna praktyka na placu manewrowym przy ul. Przemysłowej 2 i egzamin państwowy na miejscu. Zapisz się!"
  image="/og-image.jpg"
  preloadImage="/hero.webp"
  schema={faqSchema}
>
  <!-- 1. HERO SECTION -->
  <section class="relative min-h-[640px] lg:h-[82vh] flex items-center bg-brand-dark overflow-hidden py-16">
    <!-- Tło ze zdjęciem hero i przyciemnieniem teal/dark -->
    <div class="absolute inset-0 z-0">
      <img
        src="/hero.webp"
        alt="Szkolenia operatorów UDT i IMBiGS na placu manewrowym MultiSerwis w Kutnie"
        class="w-full h-full object-cover opacity-55"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1920"
        height="1080"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-brand-dark/85 to-brand-dark/55"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-8 w-full">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 bg-slate-900/90 border border-slate-700/80 rounded-full mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
          <span class="text-white text-xs font-bold uppercase tracking-wider">
            Nabór otwarty 2026 • Szkolenia stacjonarne Kutno
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-white leading-[1.1] mb-6 tracking-tight">
          Zdobądź uprawnienia operatora <br />
          <span class="text-brand-accent">w Kutnie</span>
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-slate-200 mb-10 leading-relaxed max-w-2xl">
          Certyfikowane kursy UDT, IMBiGS (ŚBŁ-WIT), SEP i spawalnictwa. Praktyczna nauka zawodu w nowoczesnej sali wykładowej oraz na poligonie manewrowym przy ul. Przemysłowej 2 z państwowym egzaminem na miejscu.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/szkolenia"
            class="px-8 py-4 bg-brand-accent hover:bg-brand-accentHover text-white font-bold uppercase tracking-wider rounded-md shadow-xl shadow-brand-accent/25 transition-all transform hover:-translate-y-0.5 inline-flex items-center justify-center gap-2.5 text-sm cursor-pointer"
          >
            <span>Przeglądaj szkolenia</span>
            <IndustrialIcon name="arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="/harmonogram"
            class="px-8 py-4 border-2 border-white/40 text-white hover:bg-white/10 hover:border-white font-bold uppercase tracking-wider rounded-md transition-all inline-flex items-center justify-center gap-2.5 text-sm cursor-pointer"
          >
            <IndustrialIcon name="calendar" class="w-4 h-4 text-brand-accent" />
            <span>Sprawdź najbliższe terminy</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SOCIAL PROOF (4 KAFLE LICZNIKÓW) -->
  <section class="bg-brand-primary border-y border-brand-secondary" aria-label="MultiSerwis w liczbach">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="flex flex-col items-center md:items-start text-center md:text-left lg:border-r border-brand-secondary/50 lg:pr-8">
          <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-brand-accent mb-4">
            <IndustrialIcon name="users" class="w-6 h-6" />
          </div>
          <div class="text-3xl md:text-4xl font-heading font-extrabold text-white mb-1">
            5000+
          </div>
          <div class="text-xs sm:text-sm uppercase tracking-wider text-slate-200 font-semibold">
            Przeszkolonych osób
          </div>
        </div>

        <div class="flex flex-col items-center md:items-start text-center md:text-left lg:border-r border-brand-secondary/50 lg:pr-8">
          <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-brand-accent mb-4">
            <IndustrialIcon name="book" class="w-6 h-6" />
          </div>
          <div class="text-3xl md:text-4xl font-heading font-extrabold text-white mb-1">
            40+
          </div>
          <div class="text-xs sm:text-sm uppercase tracking-wider text-slate-200 font-semibold">
            Dostępnych szkoleń
          </div>
        </div>

        <div class="flex flex-col items-center md:items-start text-center md:text-left lg:border-r border-brand-secondary/50 lg:pr-8">
          <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-brand-accent mb-4">
            <IndustrialIcon name="clock" class="w-6 h-6" />
          </div>
          <div class="text-3xl md:text-4xl font-heading font-extrabold text-white mb-1">
            15 lat
          </div>
          <div class="text-xs sm:text-sm uppercase tracking-wider text-slate-200 font-semibold">
            Doświadczenia w branży
          </div>
        </div>

        <div class="flex flex-col items-center md:items-start text-center md:text-left">
          <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-brand-accent mb-4">
            <IndustrialIcon name="award" class="w-6 h-6" />
          </div>
          <div class="text-3xl md:text-4xl font-heading font-extrabold text-white mb-1">
            98%
          </div>
          <div class="text-xs sm:text-sm uppercase tracking-wider text-slate-200 font-semibold">
            Zdawalności egzaminów
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2.5. PASEK AKREDYTACJI PAŃSTWOWYCH -->
  <div class="bg-slate-900 border-b border-slate-800 py-5">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
        <div>
          <div class="text-white font-heading font-bold text-sm uppercase tracking-wider">
            Oficjalne certyfikaty i uprawnienia państwowe
          </div>
          <div class="text-slate-300 text-xs sm:text-sm mt-0.5">
            Własny poligon manewrowy w Kutnie (ul. Przemysłowa 2) • Egzaminy państwowe na naszym sprzęcie
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-2.5">
          <span class="px-4 py-2 rounded-md bg-white/5 border border-white/10 text-white font-heading font-bold text-xs tracking-wider">
            UDT
          </span>
          <span class="px-4 py-2 rounded-md bg-white/5 border border-white/10 text-white font-heading font-bold text-xs tracking-wider">
            ŚBŁ-WIT (IMBiGS)
          </span>
          <span class="px-4 py-2 rounded-md bg-white/5 border border-white/10 text-white font-heading font-bold text-xs tracking-wider">
            SEP (G1, G2, G3)
          </span>
          <span class="px-4 py-2 rounded-md bg-white/5 border border-white/10 text-white font-heading font-bold text-xs tracking-wider">
            SGS / ISO 9606-1
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. WYBIERZ KATEGORIĘ SWOICH UPRAWNIEŃ (Customowe ikony SVG zamiast emotikon) -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-accent block mb-2">
          Certyfikacja państwowa
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-extrabold text-slate-900">
          Wybierz kategorię swoich uprawnień
        </h2>
        <p class="text-slate-600 text-base sm:text-lg mt-3">
          Szkolimy operatorów, elektryków i spawaczy zgodnie z wymogami polskich i europejskich jednostek dozoru
        </p>
        <div class="w-16 h-1 bg-brand-accent mx-auto mt-5 rounded-full"></div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="p-6 rounded-xl border border-slate-200/90 bg-slate-50/70 hover:bg-brand-primary hover:text-white hover:border-brand-primary transition-all duration-300 group shadow-xs hover:shadow-xl flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-primary/10 text-brand-primary group-hover:bg-brand-accent group-hover:text-white transition-colors flex items-center justify-center">
                  <IndustrialIcon name={cat.icon} class="w-6 h-6" />
                </div>
                <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-white border border-slate-200/80 text-slate-600 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-slate-200 transition-colors">
                  {cat.count}
                </span>
              </div>
              <h3 class="font-heading font-bold text-lg text-slate-900 group-hover:text-white leading-snug">
                {cat.title}
              </h3>
              <p class="text-sm text-slate-600 group-hover:text-slate-200 mt-2 leading-relaxed">
                {cat.desc}
              </p>
            </div>
            <span class="mt-6 pt-4 border-t border-slate-200/70 group-hover:border-white/15 text-xs font-bold uppercase tracking-wider text-brand-accent group-hover:text-white inline-flex items-center gap-1.5">
              <span>Sprawdź ofertę</span>
              <IndustrialIcon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. NAJPOPULARNIEJSZE SZKOLENIA -->
  <section class="py-20 bg-brand-surface border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-accent block mb-2">
          Bestsellery szkoleniowe
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-extrabold text-brand-dark">
          Najpopularniejsze szkolenia w Kutnie
        </h2>
        <p class="text-slate-600 text-base sm:text-lg mt-3">
          Zdobądź kwalifikacje operatora najczęściej poszukiwane przez pracodawców w przemyśle, logistyce i budownictwie
        </p>
        <div class="w-16 h-1 bg-brand-accent mx-auto mt-5 rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1: Wózki Widłowe -->
        <a
          href="/szkolenia/wozki-widlowe"
          class="group bg-white rounded-xl shadow-xs hover:shadow-2xl transition-all duration-300 overflow-hidden cursor-pointer flex flex-col border border-slate-200/80 hover:border-brand-accent/40"
        >
          <div class="relative h-60 overflow-hidden bg-slate-900">
            <div class="absolute top-4 right-4 z-20 bg-emerald-600 text-white text-xs font-bold px-3 py-1.5 rounded-md uppercase tracking-wide flex items-center gap-1.5 shadow-lg">
              <IndustrialIcon name="play" class="w-3.5 h-3.5" />
              <span>Teoria online 24/7</span>
            </div>
            <div class="absolute top-4 left-4 z-20 bg-brand-primary/95 backdrop-blur-xs text-white text-xs font-bold px-3 py-1 rounded-md uppercase tracking-wider">
              UDT
            </div>
            <div class="absolute inset-0 bg-brand-dark/10 group-hover:bg-brand-dark/0 transition-colors z-10"></div>
            <img
              src="/operator-wozki-widlowe.webp"
              alt="Kurs na wózki widłowe UDT Kutno"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
            />
          </div>
          <div class="p-7 flex flex-col flex-grow">
            <h3 class="text-xl font-heading font-bold text-brand-dark mb-3 group-hover:text-brand-accent transition-colors leading-snug">
              Wózki widłowe jezdniowe (UDT)
            </h3>
            <p class="text-slate-600 text-sm sm:text-base mb-6 leading-relaxed flex-grow">
              <span class="font-bold text-brand-primary block mb-1.5">
                Ucz się teorii w domu, przyjedź tylko na jazdy i egzamin!
              </span>
              Oszczędź czas dzięki platformie e-learningowej. Jazdy na placu manewrowym i egzamin państwowy w Kutnie. Uprawnienia ważne 10 lat.
            </p>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100">
              <div class="inline-flex items-center gap-1.5 text-brand-accent font-bold text-xs uppercase tracking-wider group-hover:translate-x-1 transition-transform">
                <span>Szczegóły kursu</span>
                <IndustrialIcon name="arrow-right" class="w-4 h-4" />
              </div>
              <div class="text-right">
                <span class="text-xs text-slate-500 block font-normal leading-none mb-1">cena kursu</span>
                <span class="font-heading font-extrabold text-brand-primary text-lg">
                  1 000 zł <span class="text-xs font-semibold text-slate-500">zw. z VAT</span>
                </span>
              </div>
            </div>
          </div>
        </a>

        <!-- Card 2: Ładowarki Teleskopowe -->
        <a
          href="/szkolenia/ladowarki-teleskopowe"
          class="group bg-white rounded-xl shadow-xs hover:shadow-2xl transition-all duration-300 overflow-hidden cursor-pointer flex flex-col border border-slate-200/80 hover:border-brand-accent/40"
        >
          <div class="relative h-60 overflow-hidden bg-slate-900">
            <div class="absolute top-4 right-4 z-20 bg-emerald-600 text-white text-xs font-bold px-3 py-1.5 rounded-md uppercase tracking-wide flex items-center gap-1.5 shadow-lg">
              <IndustrialIcon name="play" class="w-3.5 h-3.5" />
              <span>Teoria online 24/7</span>
            </div>
            <div class="absolute top-4 left-4 z-20 bg-brand-primary/95 backdrop-blur-xs text-white text-xs font-bold px-3 py-1 rounded-md uppercase tracking-wider">
              UDT
            </div>
            <div class="absolute inset-0 bg-brand-dark/10 group-hover:bg-brand-dark/0 transition-colors z-10"></div>
            <img
              src="/ladowarki-teleskopowe.webp"
              alt="Kurs na ładowarki teleskopowe UDT Kutno"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
            />
          </div>
          <div class="p-7 flex flex-col flex-grow">
            <h3 class="text-xl font-heading font-bold text-brand-dark mb-3 group-hover:text-brand-accent transition-colors leading-snug">
              Ładowarki teleskopowe i podnoszone
            </h3>
            <p class="text-slate-600 text-sm sm:text-base mb-6 leading-relaxed flex-grow">
              <span class="font-bold text-brand-primary block mb-1.5">
                Wózki ze zmiennym wysięgiem i podnoszoną kabiną
              </span>
              Najwyższa kategoria UDT (dawniej I WJO) obejmująca również wszystkie wózki widłowe. Uprawnienia ważne 5 lat.
            </p>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100">
              <div class="inline-flex items-center gap-1.5 text-brand-accent font-bold text-xs uppercase tracking-wider group-hover:translate-x-1 transition-transform">
                <span>Szczegóły kursu</span>
                <IndustrialIcon name="arrow-right" class="w-4 h-4" />
              </div>
              <div class="text-right">
                <span class="text-xs text-slate-500 block font-normal leading-none mb-1">cena kursu</span>
                <span class="font-heading font-extrabold text-brand-primary text-lg">
                  1 500 zł <span class="text-xs font-semibold text-slate-500">zw. z VAT</span>
                </span>
              </div>
            </div>
          </div>
        </a>

        <!-- Card 3: Koparki -->
        <a
          href="/szkolenia/koparko-ladowarki"
          class="group bg-white rounded-xl shadow-xs hover:shadow-2xl transition-all duration-300 overflow-hidden cursor-pointer flex flex-col border border-slate-200/80 hover:border-brand-accent/40"
        >
