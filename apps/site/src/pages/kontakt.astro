---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Kontakt i Dojazd | MultiSerwis Kutno - Ośrodek Szkoleniowy"
  description="Skontaktuj się z ośrodkiem MultiSerwis w Kutnie. Infolinia szkoleń: +48 730 101 000 / +48 570 403 806. Biuro: ul. Siemieradzkiego 18, Baza manewrowa: ul. Przemysłowa 2."
>
  <!-- Hero Section -->
  <div class="bg-brand-dark text-white py-14 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-2xl space-y-3">
        <span class="inline-block px-3.5 py-1 bg-brand-accent/20 border border-brand-accent/40 text-brand-accent text-xs font-bold uppercase tracking-wider rounded-sm">
          Kontakt & Lokalizacja
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black leading-tight">
          Skontaktuj się z Ośrodkiem MultiSerwis
        </h1>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Chcesz zapisać się na kurs UDT, IMBiGS lub SEP? Potrzebujesz szkolenia dla pracowników firmy? Zadzwoń do nas lub odwiedź nasze biuro w Kutnie.
        </p>
      </div>
    </div>
  </div>

  <!-- Contact Details & Form Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Column: Details & Map (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Info Card -->
          <div class="bg-white rounded-xl border border-slate-200/90 p-6 sm:p-8 shadow-sm space-y-6">
            <h2 class="text-xl font-heading font-bold text-slate-900 border-b border-slate-100 pb-4">
              Dane Teleadresowe
            </h2>

            <div class="space-y-5 text-sm">
              <div class="flex items-start gap-3.5">
                <span class="w-9 h-9 rounded-lg bg-orange-100 text-brand-accent flex items-center justify-center text-lg shrink-0">
                  📞
                </span>
                <div>
                  <span class="text-xs text-slate-500 uppercase font-semibold block">Dział Szkoleń (UDT / IMBiGS / SEP)</span>
                  <a href="tel:+48730101000" class="text-lg font-heading font-black text-brand-primary hover:text-brand-accent transition-colors block">
                    +48 730 101 000
                  </a>
                  <a href="tel:+48570403806" class="text-sm font-semibold text-slate-700 hover:text-brand-accent transition-colors block">
                    +48 570 403 806
                  </a>
                  <span class="text-xs text-slate-400 block mt-0.5">Pn–Pt: 8:00 – 16:00</span>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="w-9 h-9 rounded-lg bg-orange-50 text-brand-accent flex items-center justify-center text-lg shrink-0">
                  🏗️
                </span>
                <div>
                  <span class="text-xs text-slate-500 uppercase font-semibold block">Usługi Dźwigowe & Wynajem Maszyn</span>
                  <div class="text-base font-bold text-slate-800">+48 730 202 000</div>
                  <div class="text-sm text-slate-600">+48 733 929 100</div>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="w-9 h-9 rounded-lg bg-blue-100 text-brand-primary flex items-center justify-center text-lg shrink-0">
                  ✉️
                </span>
                <div>
                  <span class="text-xs text-slate-500 uppercase font-semibold block">E-mail biura</span>
                  <a href="mailto:multiserwis.kutno@gmail.com" class="font-bold text-brand-primary hover:text-brand-accent transition-colors block">
                    multiserwis.kutno@gmail.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="w-9 h-9 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg shrink-0">
                  🏢
                </span>
                <div>
                  <span class="text-xs text-slate-500 uppercase font-semibold block">Biuro Obsługi Klienta</span>
                  <div class="font-bold text-slate-900 leading-snug">
                    MultiSerwis Kutno<br />
                    ul. Siemieradzkiego 18<br />
                    99-300 Kutno<br />
                    <span class="text-xs text-slate-500 font-normal">Godziny otwarcia: Pn–Pt 8:00 – 16:00</span>
                  </div>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <span class="w-9 h-9 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-lg shrink-0">
                  📍
                </span>
                <div>
                  <span class="text-xs text-slate-500 uppercase font-semibold block">Baza Szkoleniowa i Plac Manewrowy</span>
                  <div class="font-bold text-slate-900 leading-snug">
                    ul. Przemysłowa 2<br />
                    99-300 Kutno<br />
                    <span class="text-xs text-emerald-600 font-semibold">✓ Bezpłatny parking dla kursantów</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Access Advice -->
            <div class="border-t border-slate-100 pt-5 space-y-2 text-xs text-slate-600">
              <div class="font-bold text-slate-800">🚘 Wskazówki dojazdu:</div>
              <p>Biuro mieści się przy ul. Siemieradzkiego 18 w Kutnie. Zajęcia praktyczne i jazdy odbywają się na naszym placu manewrowym przy ul. Przemysłowej 2 z bezpłatnym parkingiem.</p>
            </div>
          </div>

          <!-- Google Maps Embed -->
          <div class="rounded-xl overflow-hidden shadow-sm border border-slate-200 bg-white h-72">
            <iframe
              title="Multiserwis Kutno - Lokalizacja Ośrodka Szkoleniowego"
              src="https://maps.google.com/maps?q=ul.+Siemieradzkiego+18,+99-300+Kutno&t=&z=15&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <!-- Right Column: Interactive Form (7 cols) -->
        <div class="lg:col-span-7 bg-white rounded-xl border border-slate-200/90 p-6 sm:p-10 shadow-sm">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Szybki Kontakt</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 mt-1 mb-2">
            Wyślij formularz zgłoszeniowy
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mb-8">
            Nasi doradcy oddzwonią lub odpiszą na Twoje zapytanie zazwyczaj w ciągu 1-2 godzin roboczych.
          </p>

          <form id="contact-form" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Imię i nazwisko *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Jan Kowalski"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Numer telefonu *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+48 600 000 000"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all"
                />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Adres e-mail *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="twoj@email.pl"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all"
                />
              </div>

              <div>
                <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Temat / Kategoria
                </label>
                <select
                  id="subject"
                  name="subject"
                  class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 bg-white transition-all"
                >
                  <option value="Szkolenia UDT">Szkolenia UDT (Wózki, Podesty, Suwnice)</option>
                  <option value="Maszyny IMBiGS">Maszyny Budowlane IMBiGS (Koparki)</option>
                  <option value="Uprawnienia SEP">Uprawnienia SEP (G1, G2, G3)</option>
                  <option value="Kursy Spawania">Kursy Spawalnicze (MIG/MAG, TIG)</option>
                  <option value="Wynajem Maszyn">Wynajem Maszyn i Podnośników</option>
                  <option value="Serwis Maszyn">Serwis Techniczny i Konserwacja UDT</option>
                  <option value="Szkolenia Firmowe B2B">Szkolenia dla Firm / Grupy (B2B)</option>
                  <option value="Inne">Inne zapytanie</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                Treść wiadomości / Preferowany termin
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="Podaj szczegóły: ilu uczestników, jaki kurs Cię interesuje, czy potrzebujesz szkolenia w Kutnie czy w swojej firmie..."
                class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all"
              ></textarea>
            </div>

            <div class="flex items-start gap-2.5 pt-1">
              <input
                type="checkbox"
                id="consent"
                name="consent"
                required
                class="mt-1 w-4 h-4 rounded border-slate-300 text-brand-primary focus:ring-brand-primary"
              />
              <label for="consent" class="text-xs text-slate-500 leading-normal">
                Wyrażam zgodę na przetwarzanie moich danych osobowych przez MultiSerwis Kutno w celu odpowiedzi na przesłane zapytanie zgodnie z naszą <a href="/polityka-prywatnosci" class="text-brand-primary underline">Polityką Prywatności</a>.
              </label>
            </div>

            <button
              type="submit"
              class="w-full py-4 bg-brand-primary hover:bg-brand-dark text-white font-bold text-xs uppercase tracking-wider rounded-sm transition-all shadow-md cursor-pointer"
            >
              Wyślij wiadomość do doradcy →
            </button>

            <div id="form-feedback" class="hidden p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs text-center font-bold">
              ✓ Dziękujemy! Twoja wiadomość została wysłana. Skontaktujemy się z Tobą najszybciej jak to możliwe.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Simple client-side UX for the contact form
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const feedback = document.getElementById("form-feedback");

  // Pre-fill fields based on query string (e.g. ?kurs=..., ?wynajem=...)
  const params = new URLSearchParams(window.location.search);
  const kurs = params.get("kurs");
  const wynajem = params.get("wynajem");
  const termin = params.get("termin");
  const msgField = document.getElementById("message") as HTMLTextAreaElement | null;

  if (msgField) {
    if (kurs) msgField.value = `Dzień dobry, interesuje mnie zapis na szkolenie: ${kurs}. Proszę o informację o najbliższym terminie.`;
    if (wynajem) msgField.value = `Dzień dobry, chciałbym zapytać o wynajem maszyny: ${wynajem}.`;
    if (termin) msgField.value = `Dzień dobry, chciałbym zarezerwować miejsce na terminie: ${termin}.`;
  }

  if (form && feedback) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      feedback.classList.remove("hidden");
      form.reset();
      window.scrollTo({ top: feedback.offsetTop - 100, behavior: "smooth" });
    });
  }
</script>
