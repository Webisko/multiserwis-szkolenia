---
import BaseLayout from "./BaseLayout.astro";

export interface TrainingItem {
  id: string;
  title: string;
  price: string;
  description: string;
  features?: string[];
  courseSlug?: string;
}

export interface ServicePromo {
  title: string;
  description: string;
  linkText: string;
  linkUrl: string;
}

interface Props {
  title: string;
  badge?: string;
  description: string;
  trainings: TrainingItem[];
  heroImage?: string;
  servicePromo?: ServicePromo;
}

const {
  title,
  badge = "Szkolenia Zawodowe Kutno",
  description,
  trainings,
  heroImage = "/hero.webp",
  servicePromo,
} = Astro.props;
---

<BaseLayout title={`${title} - MultiSerwis Kutno`} description={description}>
  <!-- Hero Section -->
  <section class="relative bg-brand-dark text-white py-16 md:py-20 border-b border-slate-800 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover opacity-20 filter brightness-75 scale-105"
      />
      <div class="absolute inset-0 bg-linear-to-r from-brand-dark via-brand-dark/90 to-brand-primary/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block px-3.5 py-1 bg-brand-accent/20 border border-brand-accent/40 text-brand-accent text-xs font-bold uppercase tracking-wider rounded-sm">
          {badge}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black text-white leading-tight">
          {title}
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          {description}
        </p>

        <!-- Trust Badges -->
        <div class="pt-4 flex flex-wrap gap-4 text-xs font-semibold text-slate-300">
          <div class="bg-white/10 px-3 py-1.5 rounded-sm flex items-center gap-1.5">
            <span class="text-green-400 font-bold">✓</span> Egzamin Państwowy na miejscu
          </div>
          <div class="bg-white/10 px-3 py-1.5 rounded-sm flex items-center gap-1.5">
            <span class="text-green-400 font-bold">✓</span> Dostęp do e-learningu 24/7
          </div>
          <div class="bg-white/10 px-3 py-1.5 rounded-sm flex items-center gap-1.5">
            <span class="text-green-400 font-bold">✓</span> Dofinansowania BUR / KFS
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trainings Grid Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="mb-10 flex justify-between items-end">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Katalog Specjalizacji</span>
          <h2 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 mt-1">
            Dostępne Szkolenia i Kursy
          </h2>
        </div>
        <a href="/kontakt" class="text-xs font-bold uppercase tracking-wider text-brand-primary hover:text-brand-accent transition-colors hidden sm:block">
          Potrzebujesz szkolenia dla firmy? Skontaktuj się →
        </a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {trainings.map((item) => (
          <div class="bg-white rounded-xl border border-slate-200/80 p-6 flex flex-col justify-between shadow-sm hover:shadow-xl hover:border-brand-accent/40 transition-all duration-300">
            <div>
              <div class="flex justify-between items-start gap-4 mb-3">
                <h3 class="font-heading font-bold text-lg text-slate-900 leading-snug">
                  {item.title}
                </h3>
                <span class="font-heading font-black text-brand-primary text-base whitespace-nowrap">
                  {item.price}
                </span>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed mb-5">
                {item.description}
              </p>

              {item.features && item.features.length > 0 && (
                <ul class="space-y-2 mb-6 border-t border-slate-100 pt-4">
                  {item.features.map((feat) => (
                    <li class="flex items-start gap-2 text-xs text-slate-600">
                      <span class="text-green-500 font-bold shrink-0">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="pt-4 border-t border-slate-100 flex flex-col gap-2">
              <a
                href={item.courseSlug ? `/szkolenia/${item.courseSlug}` : `/szkolenia?szukaj=${encodeURIComponent(item.title)}`}
                class="block w-full text-center py-2.5 bg-brand-primary text-white font-bold rounded-sm hover:bg-brand-dark transition-colors uppercase tracking-wider text-xs"
              >
                Zobacz szczegóły i program
              </a>
              <a
                href={`/kontakt?kurs=${encodeURIComponent(item.title)}`}
                class="block w-full text-center py-2 text-xs font-bold text-brand-accent hover:text-brand-accentHover uppercase tracking-wider transition-colors"
              >
                Zapytaj o najbliższy termin →
              </a>
            </div>
          </div>
        ))}
      </div>

      <slot />

      <!-- Service Promo Card (if present) -->
      {servicePromo && (
        <div class="mt-14 rounded-2xl bg-linear-to-r from-brand-dark to-brand-primary text-white p-8 md:p-10 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 border border-white/10">
          <div class="space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Dodatkowa oferta MultiSerwis</span>
            <h3 class="text-2xl font-heading font-bold">{servicePromo.title}</h3>
            <p class="text-sm text-slate-300 max-w-2xl leading-relaxed">{servicePromo.description}</p>
          </div>
          <a
            href={servicePromo.linkUrl}
            class="shrink-0 px-6 py-3.5 bg-white text-brand-dark font-bold text-xs uppercase tracking-wider rounded-sm hover:bg-brand-accent hover:text-white transition-all shadow-md"
          >
            {servicePromo.linkText}
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
