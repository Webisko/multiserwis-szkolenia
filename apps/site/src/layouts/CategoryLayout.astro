---
import BaseLayout from "./BaseLayout.astro";
import IndustrialIcon from "../components/IndustrialIcon.astro";

export interface TrainingItem {
  id: string;
  title: string;
  price: string;
  description: string;
  features?: string[];
  courseSlug?: string;
}

export interface ServicePromo {
  title: string;
  description: string;
  linkText: string;
  linkUrl: string;
}

interface Props {
  title: string;
  badge?: string;
  description: string;
  trainings: TrainingItem[];
  heroImage?: string;
  servicePromo?: ServicePromo;
}

const {
  title,
  badge = "Szkolenia zawodowe Kutno",
  description,
  trainings,
  heroImage = "/hero.webp",
  servicePromo,
} = Astro.props;
---

<BaseLayout title={`${title} | MultiSerwis Kutno`} description={description}>
  <!-- Hero Section -->
  <section class="relative bg-brand-dark text-white py-16 md:py-20 border-b border-slate-800 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src={heroImage}
        alt={title}
        class="w-full h-full object-cover opacity-20 filter brightness-75 scale-105"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-linear-to-r from-brand-dark via-brand-dark/90 to-brand-primary/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block px-3.5 py-1 bg-brand-accent/20 border border-brand-accent/40 text-brand-accent text-xs font-bold uppercase tracking-wider rounded-md">
          {badge}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight">
          {title}
        </h1>
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed">
          {description}
        </p>

        <!-- Trust Badges -->
        <div class="pt-4 flex flex-wrap gap-3 text-xs sm:text-sm font-semibold text-slate-200">
          <div class="bg-white/10 border border-white/10 px-3.5 py-2 rounded-md flex items-center gap-2">
            <IndustrialIcon name="check-circle" class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Egzamin państwowy na miejscu</span>
          </div>
          <div class="bg-white/10 border border-white/10 px-3.5 py-2 rounded-md flex items-center gap-2">
            <IndustrialIcon name="check-circle" class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Dostęp do e-learningu 24/7</span>
          </div>
          <div class="bg-white/10 border border-white/10 px-3.5 py-2 rounded-md flex items-center gap-2">
            <IndustrialIcon name="check-circle" class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Dofinansowania BUR / KFS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trainings Grid Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
      <div class="mb-10 flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-accent block mb-1.5">
            Katalog specjalizacji
          </span>
          <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-slate-900">
            Dostępne szkolenia i kursy
          </h2>
        </div>
        <a
          href="/kontakt?typ=b2b"
          class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-primary hover:text-brand-accent transition-colors"
        >
          <span>Potrzebujesz szkolenia dla firmy? Skontaktuj się</span>
          <IndustrialIcon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {trainings.map((item) => (
          <div class="bg-white rounded-xl border border-slate-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-xl hover:border-brand-accent/40 transition-all duration-300">
            <div>
              <div class="flex flex-wrap sm:flex-nowrap justify-between items-start gap-3 mb-3">
                <h3 class="font-heading font-bold text-xl text-slate-900 leading-snug">
                  {item.title}
                </h3>
                <span class="font-heading font-extrabold text-brand-primary text-lg whitespace-nowrap">
                  {item.price}
                </span>
              </div>

              <p class="text-sm text-slate-600 leading-relaxed mb-5">
                {item.description}
              </p>

              {item.features && item.features.length > 0 && (
                <ul class="space-y-2.5 mb-6 border-t border-slate-100 pt-4">
                  {item.features.map((feat) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-700">
                      <IndustrialIcon name="check" class="w-4 h-4 text-emerald-600 shrink-0 mt-1" />
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="pt-4 border-t border-slate-100 flex flex-col gap-2.5">
              <a
                href={item.courseSlug ? `/szkolenia/${item.courseSlug}` : `/szkolenia?szukaj=${encodeURIComponent(item.title)}`}
                class="block w-full text-center py-2.5 bg-brand-primary text-white font-bold rounded-md hover:bg-brand-dark transition-colors uppercase tracking-wider text-xs"
              >
                Zobacz szczegóły i program
              </a>
              <a
                href={`/kontakt?kurs=${encodeURIComponent(item.title)}`}
                class="inline-flex items-center justify-center gap-1.5 w-full text-center py-2 text-xs font-bold text-brand-accent hover:text-brand-accentHover uppercase tracking-wider transition-colors"
              >
                <span>Zapytaj o najbliższy termin</span>
                <IndustrialIcon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        ))}
      </div>

      <slot />

      <!-- Service Promo Card (if present) -->
      {servicePromo && (
        <div class="mt-14 rounded-xl bg-linear-to-r from-brand-dark to-brand-primary text-white p-8 md:p-10 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 border border-white/10">
          <div class="space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Dodatkowa oferta MultiSerwis</span>
            <h3 class="text-2xl font-heading font-bold">{servicePromo.title}</h3>
            <p class="text-sm sm:text-base text-slate-200 max-w-2xl leading-relaxed">{servicePromo.description}</p>
          </div>
          <a
            href={servicePromo.linkUrl}
            class="shrink-0 px-6 py-3.5 bg-white text-brand-dark font-bold text-xs uppercase tracking-wider rounded-md hover:bg-brand-accent hover:text-white transition-all shadow-md inline-flex items-center gap-2"
          >
            <span>{servicePromo.linkText}</span>
            <IndustrialIcon name="arrow-right" class="w-4 h-4" />
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
