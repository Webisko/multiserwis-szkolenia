---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloadImage?: string | null;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title = "MultiSerwis Kutno | Kursy i szkolenia UDT, IMBiGS, SEP • Wynajem maszyn",
  description = "Zdobądź uprawnienia operatora UDT, IMBiGS i SEP w Kutnie. Teoria online 24/7, praktyka na własnym placu manewrowym przy ul. Przemysłowej 2 i egzamin państwowy. Zapisz się online!",
  image = "/og-image.jpg",
  preloadImage = null,
  schema,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : "https://multiserwis.edu.pl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = image.startsWith("http") ? image : new URL(image, siteOrigin).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "@id": `${siteOrigin}/#organization`,
  name: "MultiSerwis Kutno – Ośrodek Szkolenia Zawodowego i Wynajem Maszyn",
  legalName: "MULTISERWIS KUTNO SPÓŁKA Z OGRANICZONĄ ODPOWIEDZIALNOŚCIĄ",
  url: siteOrigin,
  logo: `${siteOrigin}/logo.svg`,
  image: ogImageUrl,
  description:
    "Akredytowany ośrodek szkoleń operatorów UDT, IMBiGS (ŚBŁ-WIT), uprawnień energetycznych SEP (G1, G2, G3) i spawalnictwa oraz wypożyczalnia i serwis maszyn budowlanych w Kutnie.",
  telephone: "+48 730 101 000",
  email: "multiserwis.kutno@gmail.com",
  taxID: "7752676330",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ul. Przemysłowa 2",
    addressLocality: "Kutno",
    postalCode: "99-300",
    addressRegion: "łódzkie",
    addressCountry: "PL",
  },
  location: [
    {
      "@type": "Place",
      name: "Biuro Obsługi Klienta MultiSerwis",
      address: {
        "@type": "PostalAddress",
        streetAddress: "ul. Henryka Siemiradzkiego 18",
        addressLocality: "Kutno",
        postalCode: "99-300",
        addressCountry: "PL",
      },
    },
    {
      "@type": "Place",
      name: "Baza Szkoleniowa i Plac Manewrowy MultiSerwis",
      address: {
        "@type": "PostalAddress",
        streetAddress: "ul. Przemysłowa 2",
        addressLocality: "Kutno",
        postalCode: "99-300",
        addressCountry: "PL",
      },
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:00",
      closes: "16:00",
    },
  ],
  areaServed: ["Kutno", "Łódź", "Płock", "Łowicz", "Łęczyca", "Gostynin", "Koło", "Konin"],
};

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLdGraph = [organizationSchema, ...extraSchemas];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260924" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20260924" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20260924" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260924" />

    <!-- AI Agentic Browsing (ARD & LLMs) -->
    <link rel="describedby" href="/llms.txt" />
    <link rel="alternate" type="application/json" href="/.well-known/ai-catalog.json" />

    <!-- Preload Critical Typography & Optional Hero LCP Image -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preload" href="/fonts/montserrat-700-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/roboto-400-latin-ext.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Facebook / LinkedIn / Messenger -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="MultiSerwis Kutno" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </head>
  <body>
    <div class="min-h-screen bg-slate-50 text-slate-900 overflow-x-hidden flex flex-col">
      <SiteHeader />
      <main class="relative grow">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
