---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const {
  title = "MultiSerwis Kutno | Kursy i Szkolenia UDT, IMBiGS, SEP",
  description = "Zdobądź uprawnienia operatora UDT, IMBiGS i SEP w Kutnie. Teoria online 24/7, praktyka na własnym placu manewrowym i egzamin państwowy. Zapisz się online!",
  image = "/og-image.jpg",
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : "https://multiserwis-szkolenia.webisko.pl";
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = image.startsWith("http") ? image : new URL(image, siteOrigin).toString();
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/logo.svg" />

    <!-- Open Graph / Facebook / LinkedIn / Messenger -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="MultiSerwis Kutno" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <div class="min-h-screen bg-slate-50 text-slate-900 overflow-x-hidden">
      <SiteHeader />
      <main class="relative">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

