{
  "name": "multiserwis-kutno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/site run dev",
    "build": "node scripts/build-hybrid.mjs",
    "preview": "npm --workspace apps/site run preview",
    "build:server": "node scripts/build-hybrid.mjs",
    "build:hybrid": "node scripts/build-hybrid.mjs",
    "preview:server": "npm --workspace apps/site run preview",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-prod-seohost.ps1",
    "deploy:staging": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-prod-seohost.ps1",
    "site:dev": "npm --workspace apps/site run dev",
    "site:build": "npm --workspace apps/site run build",
    "site:preview": "npm --workspace apps/site run preview",
    "shared:build": "npm --workspace packages/shared run build",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "lucide-react": "^0.562.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
